      "rationaleRefs": ["RAT-001"],
      "earsPattern": "EventDriven",
      "subjectSystemRef": "TERM-SYS-001",
      "actorRef": "TERM-ACT-001",
      "triggerEventRef": "TERM-EVT-001",
      "preconditions": [],
      "behavior": {
        "kind": "CREATE",
        "targetTermRef": "TERM-OBJ-001",
        "timing": "IMMEDIATE"
      }
    },
    {
      "id": "REQ-001-2",
