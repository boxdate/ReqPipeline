{
  "schemaVersion": "2.0",
  "documentId": "DOC-CRUD-001",
  "title": "顧客管理CRUDアプリケーション要件仕様",
  "description": "顧客情報の作成・一覧表示・詳細遷移および管理者以外の削除禁止を定義するV2正本サンプル。",
  "rationales": [
    {
      "id": "RAT-001",
      "title": "顧客情報の一元管理と業務効率化",
      "description": "営業およびサポート担当者が最新の顧客情報を迅速に登録・閲覧・詳細確認できるようにする。",
      "stakeholder": "営業部門"
    },
    {
      "id": "RAT-002",
      "title": "誤削除防止とアクセス制御の徹底",
      "description": "権限を持たない利用者による顧客データの誤削除・不正削除を防止する。",
      "stakeholder": "情報セキュリティ担当"
    }
  ],
