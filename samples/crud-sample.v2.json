  "escapeRecords": [],
  "journeys": [
    {
      "id": "JRN-001",
      "title": "新規登録〜詳細確認〜編集〜一覧復帰フロー",
      "description": "一覧画面から新規顧客を登録し、詳細確認・編集を経て一覧画面へ綺麗に戻る正常系ジャーニー。",
      "initialStates": {
        "TERM-LC-001": "List",
        "TERM-SV-001": "Member"
      },
      "steps": [
        {
          "stepId": "STEP-001",
          "userAction": "一覧画面で「新規登録」ボタンを押して作成画面へ移動する",
          "requirementRef": "REQ-001-4"
        },
        {
          "stepId": "STEP-002",
          "userAction": "顧客情報を入力して登録ボタンを押し、顧客レコードを作成する",
          "requirementRef": "REQ-001-1"
        },
        {
          "stepId": "STEP-003",
          "userAction": "作成完了後に一覧画面へ戻る",
          "requirementRef": "REQ-001-5"
        },
        {
          "stepId": "STEP-004",
          "userAction": "一覧画面で登録済み顧客一覧を確認する",
          "requirementRef": "REQ-001-2"
        },
        {
          "stepId": "STEP-005",
          "userAction": "一覧から対象の顧客を選択して詳細画面へ遷移する",
          "requirementRef": "REQ-001-3"
        },
        {
          "stepId": "STEP-006",
          "userAction": "詳細画面で「編集」ボタンを押して編集画面へ移動する",
          "requirementRef": "REQ-001-6"
        },
        {
          "stepId": "STEP-007",
          "userAction": "顧客情報を更新保存して詳細画面へ戻る",
          "requirementRef": "REQ-001-7"
        },
        {
          "stepId": "STEP-008",
          "userAction": "詳細画面から「一覧へ戻る」を押して一覧画面へ復帰する",
          "requirementRef": "REQ-001-8"
        }
      ]
    },
    {
      "id": "JRN-002",
      "title": "管理者以外の削除ブロック確認フロー",
      "description": "UserRole = Member の状態で詳細画面から顧客削除を試み、禁止ルール（PROHIBIT）が発動することを確認する異常系ジャーニー。",
      "initialStates": {
        "TERM-LC-001": "Detail",
        "TERM-SV-001": "Member"
      },
      "steps": [
        {
          "stepId": "STEP-001",
          "userAction": "一般メンバー権限で詳細画面の「削除」ボタンを押して削除を試みる",
          "requirementRef": "REQ-002-1"
        },
        {
          "stepId": "STEP-002",
          "userAction": "削除がブロックされた後、一覧画面へ戻る",
          "requirementRef": "REQ-001-8"
        }
      ]
    }
  ],
  "achievementCriteria": [
    {
      "id": "AC-001",
      "rationaleId": "RAT-001",
      "title": "顧客情報の登録・閲覧・編集と画面遷移の正常動作",
      "description": "利用者が一覧画面から新規顧客の登録・一覧確認・詳細閲覧・編集および一覧復帰までの一連のCRUD操作を迷わず完了できること。",
      "linkedCompositeIds": ["REQ-001"],
      "linkedJourneyIds": ["JRN-001"],
      "viewpointTags": ["正", "画面遷移"]
    },
    {
      "id": "AC-002",
      "rationaleId": "RAT-002",
      "title": "権限に基づく顧客削除保護と安全な画面復帰",
      "description": "管理者以外の利用者による顧客削除操作が確実にブロックされ、ブロック後も一覧画面への安全な操作継続ができること。",
      "linkedCompositeIds": ["REQ-002"],
      "linkedJourneyIds": ["JRN-002"],
      "viewpointTags": ["禁", "権限"],
      "manualVerificationNote": "URL直打ちやAPI直接呼び出しで一般メンバー・閲覧者が削除エンドポイントを実行した場合も403で拒否されることを手動確認する。"
    }
  ]
}
