      "namespace": "customer.security",
      "nodeKind": "Composite",
      "rationaleRefs": ["RAT-002"],
      "earsPattern": "UnwantedBehavior",
      "subjectSystemRef": "TERM-SYS-001",
      "actorRef": "TERM-ACT-001",
      "triggerEventRef": "TERM-EVT-004",
      "preconditions": [
        {
          "stateTermRef": "TERM-SV-001",
          "operator": "NEQ",
          "expectedValues": ["Admin"]
        }
      ]
    },
    {
      "id": "REQ-002-1",
      "title": "管理者以外の顧客削除禁止",
      "nodeKind": "Atomic",
      "parentRequirementId": "REQ-002",
      "rationaleRefs": ["RAT-002"],
      "earsPattern": "UnwantedBehavior",
      "subjectSystemRef": "TERM-SYS-001",
