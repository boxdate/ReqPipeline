{
  "schemaVersion": "2.1",
  "documentId": "DOC-DOORLOCK-001",
  "title": "車両ドアロック＆警告制御システム要件仕様",
  "description": "車載ドアロック制御ECUにおける施錠・解錠遷移、半ドア／走行中インターロック、アンサーバック鳴動および故障コード記録を定義する多ドメイン検証サンプル。",
  "rationales": [
    {
      "id": "RAT-001",
      "title": "乗員の乗降利便性と施錠状態フィードバック",
      "description": "運転者のスイッチ操作に応じて確実に施錠・解錠を行い、施錠完了をブザーで分かりやすく通知する。",
      "stakeholder": "車両商品企画・乗員"
    },
    {
      "id": "RAT-002",
      "title": "誤動作・走行中誤解錠に対する車両安全性確保",
      "description": "半ドア状態での誤施錠や走行中の誤解錠をインターロックし、乗員の安全を確保する。",
      "stakeholder": "車両機能安全担当"
    },
    {
      "id": "RAT-003",
      "title": "故障診断・保守性の確保",
      "description": "ドアロック機構の異常検知時に故障コード(DTC)を記録し、整備時の原因特定を容易にする。",
      "stakeholder": "サービス・保守部門"
    }
  ],
