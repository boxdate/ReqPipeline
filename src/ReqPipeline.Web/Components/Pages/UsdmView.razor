@page "/usdm"
@implements IDisposable
@inject WorkspaceStateService Workspace
@inject IJSRuntime JS

<PageTitle>USDM View - ReqPipeline V2</PageTitle>

<div class="container py-3" style="max-width: 1140px;">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0 v2-text-primary">USDM Markdown View</h4>
            <div class="v2-text-muted small">
                <code>UsdmMarkdownRenderer</code> による <code>Rationale → Composite → Atomic</code> の決定論的出力
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (_copied)
            {
                <span class="v2-badge v2-badge-success">
                    <UiIcon Name="check-circle" Size="12" />
                    <span>コピーしました</span>
                </span>
            }
            <button type="button" class="v2-btn v2-btn-sm v2-btn-outline" @onclick="CopyMarkdown">
                <UiIcon Name="copy" Size="13" />
                <span>Markdown をコピー</span>
            </button>
            <button type="button" class="v2-btn v2-btn-sm v2-btn-primary" @onclick="DownloadMarkdown">
                <UiIcon Name="download" Size="13" />
                <span>.md ダウンロード</span>
            </button>
        </div>
    </div>

    <div class="row g-3">
        <!-- Structured Visual Preview -->
        <div class="col-lg-6">
            <div class="v2-card h-100">
                <div class="wb-section-title">Structured Hierarchy Preview</div>
                <h5 class="fw-bold v2-text-primary">@Workspace.Document.Title</h5>
                @if (!string.IsNullOrWhiteSpace(Workspace.Document.Description))
                {
                    <p class="small v2-text-secondary v2-prose">@Workspace.Document.Description</p>
                }

                @foreach (var rat in Workspace.Document.Rationales)
                {
                    <div class="v2-usdm-rationale">
                        <div class="fw-bold v2-text-primary">
                            <span class="v2-mono-id me-1">@rat.Id</span>@rat.Title
                        </div>
                        <div class="small v2-text-secondary v2-prose mb-2">@rat.Description</div>

                        @foreach (var comp in Workspace.Document.Requirements
                            .Where(r => string.IsNullOrWhiteSpace(r.ParentRequirementId) && r.RationaleRefs.Contains(rat.Id)))
                        {
                            <div class="ms-2 mt-2">
                                <div class="fw-semibold small v2-text-primary">
                                    <span class="v2-mono-id me-1">@comp.Id</span>@comp.Title
                                </div>
                                @if (!string.IsNullOrWhiteSpace(comp.Summary))
                                {
                                    <div class="small v2-usdm-summary mt-1 mb-2">@comp.Summary</div>
                                }
                                <ol class="small v2-prose mt-1 mb-0">
                                    @foreach (var child in Workspace.Document.Requirements.Where(c => c.ParentRequirementId == comp.Id))
                                    {
                                        <li class="mb-1">
                                            <span class="v2-mono-id fw-bold me-1">@child.Id</span>
                                            <strong class="v2-text-primary">@child.Title</strong>
                                            <span class="v2-badge v2-badge-outline mx-1">@child.EarsPattern</span>
                                            <span class="v2-text-secondary">@Workspace.RenderJapanesePreview(child)</span>
                                        </li>
                                    }
                                </ol>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Raw Markdown -->
        <div class="col-lg-6">
            <div class="v2-card h-100 d-flex flex-column">
                <div class="wb-section-title">Generated Markdown Source</div>
                <pre class="v2-code-block flex-grow-1">@Workspace.RenderUsdmMarkdown()</pre>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _copied;

    protected override void OnInitialized()
    {
        Workspace.OnChange += HandleChanged;
    }

    private void HandleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CopyMarkdown()
    {
        var md = Workspace.RenderUsdmMarkdown();
        await JS.InvokeVoidAsync("reqPipelineV2.copyToClipboard", md);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    private async Task DownloadMarkdown()
    {
        var md = Workspace.RenderUsdmMarkdown();
        var docId = string.IsNullOrWhiteSpace(Workspace.Document.DocumentId)
            ? "usdm-spec"
            : Workspace.Document.DocumentId.ToLowerInvariant();
        await JS.InvokeVoidAsync("reqPipelineV2.downloadTextFile", $"{docId}.usdm.md", md, "text/markdown;charset=utf-8");
    }

    public void Dispose()
    {
        Workspace.OnChange -= HandleChanged;
    }
}
