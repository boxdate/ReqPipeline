@page "/glossary"
@implements IDisposable
@inject WorkspaceStateService Workspace
@inject IJSRuntime JS

<PageTitle>Glossary - ReqPipeline V2</PageTitle>

<div class="container-fluid py-3 px-4" style="max-width: 1400px;">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0">Glossary 管理 (承認済み語彙)</h4>
            <div class="text-muted small">Workbench のスロット候補と LINT-001〜LINT-011 の正本語彙を管理します。</div>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <select class="form-select form-select-sm" style="width: auto;"
                    @bind="_importMode" title="Glossary インポート時のマージ動作">
                <option value="@GlossaryImportMode.MergeOverwrite">マージ (同ID上書き)</option>
                <option value="@GlossaryImportMode.MergeSkipExisting">マージ (同IDスキップ)</option>
                <option value="@GlossaryImportMode.ReplaceAll">全置換</option>
            </select>
            <label class="btn btn-outline-secondary btn-sm mb-0" style="cursor: pointer;" title="Glossary JSON をインポート">
                ⬆ JSON インポート
                <InputFile OnChange="HandleImportGlossaryJson" accept=".json,application/json" style="display:none" />
            </label>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="HandleExportGlossaryJson" title="現在の Glossary を JSON でエクスポート">
                ⬇ JSON エクスポート
            </button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="CreateNewTerm">
                ＋ 新規語彙を追加
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_transferMessage))
    {
        <div class="alert @(_transferIsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 px-3 small mb-3" role="alert">
            @_transferMessage
            <button type="button" class="btn-close btn-close-sm" style="padding: 0.65rem 0.75rem;"
                    @onclick="() => _transferMessage = null"></button>
        </div>
    }

    <div class="row g-3">
        <!-- Term List -->
        <div class="col-lg-7">
            <div class="slot-card">
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <input type="text" class="form-control form-control-sm" placeholder="ID・名称で検索..."
                               @bind="_searchText" @bind:event="oninput" />
                    </div>
                    <div class="col-md-7">
                        <div class="chip-group">
                            <button type="button" class="slot-chip @(_filterType is null ? "active" : "")"
                                    @onclick="() => _filterType = null">
                                すべて (@Workspace.Document.Glossary.Count)
                            </button>
                            @foreach (var ct in Enum.GetValues<ConceptType>())
                            {
                                var count = Workspace.Document.Glossary.Count(t => t.ConceptType == ct);
                                <button type="button" class="slot-chip @(_filterType == ct ? "active" : "")"
                                        @onclick="() => _filterType = ct">
                                    @ct (@count)
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>表示名 / 英語シンボル</th>
                                <th>ConceptType</th>
                                <th>LogicalType</th>
                                <th>単位</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var term in FilteredTerms())
                            {
                                var isSelected = _selectedTermId == term.Id;
                                <tr class="@(isSelected ? "table-primary" : "")" style="cursor:pointer"
                                    @onclick="() => SelectTerm(term.Id)">
                                    <td class="font-monospace small">@term.Id</td>
                                    <td>
                                        <div class="fw-semibold">@term.GetDisplayName()</div>
                                        <div class="font-monospace small text-muted">@term.CanonicalName</div>
                                    </td>
                                    <td><span class="chip-badge chip-type">@term.ConceptType</span></td>
                                    <td class="small">
                                        @if (term.LogicalType.Kind == LogicalTypeKind.Enum)
                                        {
                                            <span>Enum [@string.Join(", ", term.LogicalType.AllowedValues.Select(v => FormatValueWithLabel(term.LogicalType, v)))]</span>
                                        }
                                        else
                                        {
                                            <span>@term.LogicalType.Kind</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(term.Unit ?? "-")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteTerm(term.Id)">
                                            削除
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Term Editor -->
        <div class="col-lg-5">
            @{
                var editing = GetSelectedTerm();
            }
            @if (editing is null)
            {
                <div class="slot-card text-center text-muted py-5">
                    左の一覧から語彙を選択するか、「＋ 新規語彙を追加」をクリックしてください。
                </div>
            }
            else
            {
                <div class="slot-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="fw-bold">語彙の編集</span>
                        <span class="badge bg-secondary font-monospace">@editing.Id</span>
                    </div>

                    <div class="mb-2">
                        <label class="slot-label">ID</label>
                        <input type="text" class="form-control form-control-sm font-monospace"
                               value="@editing.Id"
                               @onchange="e => RenameTermId(editing, e.Value?.ToString())" />
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="slot-label">英語シンボル (CanonicalName)</label>
                            <input type="text" class="form-control form-control-sm font-monospace"
                                   placeholder="例: VehicleSpeed"
                                   value="@editing.CanonicalName"
                                   @oninput="e => { editing.CanonicalName = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }" />
                        </div>
                        <div class="col-md-6">
                            <label class="slot-label">日本語表示名 (DisplayName)</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="例: 車速"
                                   value="@editing.DisplayName"
                                   @oninput="e => { editing.DisplayName = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }" />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="slot-label">ConceptType (7種)</label>
                            <select class="form-select form-select-sm"
                                    value="@editing.ConceptType"
                                    @onchange="e => OnConceptTypeChanged(editing, e.Value?.ToString())">
                                @foreach (var ct in Enum.GetValues<ConceptType>())
                                {
                                    <option value="@ct">@ct</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="slot-label">Namespace</label>
                            <input type="text" class="form-control form-control-sm" placeholder="例: customer.domain"
                                   value="@editing.Namespace"
                                   @oninput="e => { editing.Namespace = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Workspace.NotifyChanged(); }" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="slot-label">説明 (Description)</label>
                        <textarea class="form-control form-control-sm" rows="2"
                                  value="@editing.Description"
                                  @oninput="e => { editing.Description = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }"></textarea>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <label class="slot-label">LogicalType (値ドメイン定義)</label>
                        <div class="chip-group">
                            @foreach (var kind in Enum.GetValues<LogicalTypeKind>())
                            {
                                <button type="button"
                                        class="slot-chip @(editing.LogicalType.Kind == kind ? "active" : "")"
                                        @onclick="() => OnLogicalTypeKindChanged(editing, kind)">
                                    @kind
                                </button>
                            }
                        </div>
                    </div>

                    @if (editing.LogicalType.Kind == LogicalTypeKind.Boolean)
                    {
                        <div class="mt-2">
                            <div class="small text-muted mb-2">
                                許容値: <code>true</code> / <code>false</code>（自動閉包）— 表示ラベル（任意）:
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text font-monospace">true</span>
                                        <input type="text" class="form-control" placeholder="例: 有効 / 施錠"
                                               value="@GetValueLabelInput(editing.LogicalType, "true")"
                                               @oninput='e => SetValueLabel(editing.LogicalType, "true", e.Value?.ToString())' />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text font-monospace">false</span>
                                        <input type="text" class="form-control" placeholder="例: 無効 / 解錠"
                                               value="@GetValueLabelInput(editing.LogicalType, "false")"
                                               @oninput='e => SetValueLabel(editing.LogicalType, "false", e.Value?.ToString())' />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (editing.LogicalType.Kind == LogicalTypeKind.Enum)
                    {
                        <div class="mt-3">
                            <label class="slot-label">AllowedValues (英語正規値) ＋ ValueLabels (日本語表示)</label>
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" class="form-control font-monospace" placeholder="英語シンボル (例: HighSpeed)"
                                       @bind="_newEnumValue"
                                       @onkeydown="e => OnEnumInputKeyDown(e, editing)" />
                                <input type="text" class="form-control" placeholder="日本語表示 (例: 高速)"
                                       @bind="_newEnumLabel"
                                       @onkeydown="e => OnEnumInputKeyDown(e, editing)" />
                                <button type="button" class="btn btn-outline-primary" @onclick="() => AddEnumValue(editing)">
                                    追加
                                </button>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                @foreach (var val in editing.LogicalType.AllowedValues.ToList())
                                {
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text font-monospace" style="min-width: 110px;">@val</span>
                                        <input type="text" class="form-control" placeholder="日本語表示ラベル (任意)"
                                               value="@GetValueLabelInput(editing.LogicalType, val)"
                                               @oninput="e => SetValueLabel(editing.LogicalType, val, e.Value?.ToString())" />
                                        <button type="button" class="btn btn-outline-danger"
                                                @onclick="() => RemoveEnumValue(editing, val)">×</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <hr />

                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="slot-label">単位 (Unit)</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="例: km/h, ms"
                                   value="@editing.Unit"
                                   @oninput="e => { editing.Unit = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Workspace.NotifyChanged(); }" />
                        </div>
                        <div class="col-md-8">
                            <label class="slot-label">物理抽象化メモ (AbstractionNote)</label>
                            <input type="text" class="form-control form-control-sm" placeholder="例: 車速 >= 30 km/h を HighSpeed として抽象化"
                                   value="@editing.AbstractionNote"
                                   @oninput="e => { editing.AbstractionNote = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Workspace.NotifyChanged(); }" />
                        </div>
                    </div>

                    <div class="mt-2">
                        <label class="slot-label">禁止語 (DeprecatedLabels)</label>
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" class="form-control" placeholder="禁止・非推奨表記を入力 (例: スピード)"
                                   @bind="_newDeprecatedLabel"
                                   @onkeydown="e => OnDeprecatedInputKeyDown(e, editing)" />
                            <button type="button" class="btn btn-outline-danger" @onclick="() => AddDeprecatedLabel(editing)">
                                追加
                            </button>
                        </div>
                        <div class="chip-group">
                            @foreach (var label in editing.DeprecatedLabels.ToList())
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1 px-2 py-1">
                                    @label
                                    <button type="button" class="btn-close" style="font-size: 0.55rem;"
                                            aria-label="Remove"
                                            @onclick="() => RemoveDeprecatedLabel(editing, label)"></button>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _searchText = string.Empty;
    private ConceptType? _filterType;
    private string? _selectedTermId;
    private string _newEnumValue = string.Empty;
    private string _newEnumLabel = string.Empty;
    private string _newDeprecatedLabel = string.Empty;
    private GlossaryImportMode _importMode = GlossaryImportMode.MergeOverwrite;
    private string? _transferMessage;
    private bool _transferIsError;

    protected override void OnInitialized()
    {
        Workspace.OnChange += HandleChanged;
        _selectedTermId = Workspace.Document.Glossary.FirstOrDefault()?.Id;
    }

    private void HandleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<ApprovedGlossaryTerm> FilteredTerms()
    {
        IEnumerable<ApprovedGlossaryTerm> query = Workspace.Document.Glossary;
        if (_filterType.HasValue)
        {
            query = query.Where(t => t.ConceptType == _filterType.Value);
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(t =>
                t.Id.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || t.CanonicalName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || t.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || t.Aliases.Any(a => a.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));
        }

        return query;
    }

    private ApprovedGlossaryTerm? GetSelectedTerm() =>
        _selectedTermId is null
            ? null
            : Workspace.Document.Glossary.FirstOrDefault(t => string.Equals(t.Id, _selectedTermId, StringComparison.Ordinal));

    private void SelectTerm(string termId)
    {
        _selectedTermId = termId;
        _newEnumValue = string.Empty;
        _newEnumLabel = string.Empty;
        _newDeprecatedLabel = string.Empty;
    }

    private void CreateNewTerm()
    {
        var idx = Workspace.Document.Glossary.Count + 1;
        var id = $"TERM-NEW-{idx:000}";
        while (Workspace.Document.Glossary.Any(t => t.Id == id))
        {
            idx++;
            id = $"TERM-NEW-{idx:000}";
        }

        var term = new ApprovedGlossaryTerm
        {
            Id = id,
            CanonicalName = $"NewTerm{idx}",
            DisplayName = $"新規語彙 {idx}",
            ConceptType = _filterType ?? ConceptType.DomainObject,
            LogicalType = new LogicalTypeDefinition { Kind = LogicalTypeKind.None }
        };

        Workspace.AddGlossaryTerm(term);
        _selectedTermId = term.Id;
    }

    private void DeleteTerm(string termId)
    {
        Workspace.DeleteGlossaryTerm(termId);
        if (_selectedTermId == termId)
        {
            _selectedTermId = Workspace.Document.Glossary.FirstOrDefault()?.Id;
        }
    }

    private void RenameTermId(ApprovedGlossaryTerm term, string? newId)
    {
        if (string.IsNullOrWhiteSpace(newId))
        {
            return;
        }

        term.Id = newId.Trim();
        _selectedTermId = term.Id;
        Workspace.NotifyChanged();
    }

    private void OnConceptTypeChanged(ApprovedGlossaryTerm term, string? typeStr)
    {
        if (Enum.TryParse<ConceptType>(typeStr, out var ct))
        {
            term.ConceptType = ct;
            Workspace.NotifyChanged();
        }
    }

    private void OnLogicalTypeKindChanged(ApprovedGlossaryTerm term, LogicalTypeKind kind)
    {
        term.LogicalType.Kind = kind;
        if (kind != LogicalTypeKind.Enum)
        {
            term.LogicalType.AllowedValues.Clear();
        }
        foreach (var invalidKey in term.LogicalType.ValueLabels.Keys.Where(k => !term.LogicalType.IsValidValue(k)).ToList())
        {
            term.LogicalType.ValueLabels.Remove(invalidKey);
        }
        Workspace.NotifyChanged();
    }

    private void AddEnumValue(ApprovedGlossaryTerm term)
    {
        var trimmed = _newEnumValue.Trim();
        if (!string.IsNullOrEmpty(trimmed) && !term.LogicalType.AllowedValues.Contains(trimmed, StringComparer.Ordinal))
        {
            term.LogicalType.AllowedValues.Add(trimmed);
            var trimmedLabel = _newEnumLabel.Trim();
            if (!string.IsNullOrEmpty(trimmedLabel))
            {
                term.LogicalType.ValueLabels[trimmed] = trimmedLabel;
            }
            _newEnumValue = string.Empty;
            _newEnumLabel = string.Empty;
            Workspace.NotifyChanged();
        }
    }

    private void OnEnumInputKeyDown(KeyboardEventArgs e, ApprovedGlossaryTerm term)
    {
        if (e.Key == "Enter")
        {
            AddEnumValue(term);
        }
    }

    private void RemoveEnumValue(ApprovedGlossaryTerm term, string val)
    {
        term.LogicalType.AllowedValues.Remove(val);
        term.LogicalType.ValueLabels.Remove(val);
        Workspace.NotifyChanged();
    }

    private static string GetValueLabelInput(LogicalTypeDefinition logicalType, string key) =>
        logicalType.ValueLabels.TryGetValue(key, out var label) ? label : string.Empty;

    private void SetValueLabel(LogicalTypeDefinition logicalType, string key, string? label)
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            logicalType.ValueLabels.Remove(key);
        }
        else
        {
            logicalType.ValueLabels[key] = label.Trim();
        }
        Workspace.NotifyChanged();
    }

    private static string FormatValueWithLabel(LogicalTypeDefinition logicalType, string val)
    {
        var label = logicalType.GetValueLabel(val);
        return string.Equals(label, val, StringComparison.Ordinal) ? val : $"{label}({val})";
    }

    private void AddDeprecatedLabel(ApprovedGlossaryTerm term)
    {
        var trimmed = _newDeprecatedLabel.Trim();
        if (!string.IsNullOrEmpty(trimmed) && !term.DeprecatedLabels.Contains(trimmed, StringComparer.Ordinal))
        {
            term.DeprecatedLabels.Add(trimmed);
            _newDeprecatedLabel = string.Empty;
            Workspace.NotifyChanged();
        }
    }

    private void OnDeprecatedInputKeyDown(KeyboardEventArgs e, ApprovedGlossaryTerm term)
    {
        if (e.Key == "Enter")
        {
            AddDeprecatedLabel(term);
        }
    }

    private void RemoveDeprecatedLabel(ApprovedGlossaryTerm term, string label)
    {
        term.DeprecatedLabels.Remove(label);
        Workspace.NotifyChanged();
    }

    private async Task HandleExportGlossaryJson()
    {
        var json = Workspace.ExportGlossaryJson();
        var docId = string.IsNullOrWhiteSpace(Workspace.Document.DocumentId)
            ? "glossary"
            : $"glossary-{Workspace.Document.DocumentId.ToLowerInvariant()}";
        var fileName = $"{docId}.v2.json";

        await JS.InvokeVoidAsync("reqPipelineV2.downloadTextFile", fileName, json, "application/json;charset=utf-8");
        _transferIsError = false;
        _transferMessage = $"'{fileName}' をエクスポートしました（{Workspace.Document.Glossary.Count}件）。";
    }

    private async Task HandleImportGlossaryJson(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            if (Workspace.TryImportGlossaryJson(json, _importMode, out var result, out var error) && result is not null)
            {
                _transferIsError = false;
                _transferMessage = $"'{file.Name}' をインポートしました（追加: {result.AddedCount}件 / 更新: {result.UpdatedCount}件 / スキップ: {result.SkippedCount}件）。";
                if (_selectedTermId is null || !Workspace.Document.Glossary.Any(t => t.Id == _selectedTermId))
                {
                    _selectedTermId = Workspace.Document.Glossary.FirstOrDefault()?.Id;
                }
            }
            else
            {
                _transferIsError = true;
                _transferMessage = error ?? "Glossary JSON のインポートに失敗しました。";
            }
        }
        catch (Exception ex)
        {
            _transferIsError = true;
            _transferMessage = $"ファイル読み込みエラー: {ex.Message}";
        }
    }

    public void Dispose()
    {
        Workspace.OnChange -= HandleChanged;
    }
}
