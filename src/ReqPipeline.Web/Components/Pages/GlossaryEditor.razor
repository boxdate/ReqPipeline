@page "/glossary"
@implements IDisposable
@inject WorkspaceStateService Workspace

<PageTitle>Glossary - ReqPipeline V2</PageTitle>

<div class="container-fluid py-3 px-4" style="max-width: 1400px;">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0">Glossary 管理 (承認済み語彙)</h4>
            <div class="text-muted small">Workbench のスロット候補と LINT-001 / LINT-002 / LINT-003 の正本語彙を管理します。</div>
        </div>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateNewTerm">
            ＋ 新規語彙を追加
        </button>
    </div>

    <div class="row g-3">
        <!-- Term List -->
        <div class="col-lg-7">
            <div class="slot-card">
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <input type="text" class="form-control form-control-sm" placeholder="ID・名称で検索..."
                               @bind="_searchText" @bind:event="oninput" />
                    </div>
                    <div class="col-md-7">
                        <div class="chip-group">
                            <button type="button" class="slot-chip @(_filterType is null ? "active" : "")"
                                    @onclick="() => _filterType = null">
                                すべて (@Workspace.Document.Glossary.Count)
                            </button>
                            @foreach (var ct in Enum.GetValues<ConceptType>())
                            {
                                var count = Workspace.Document.Glossary.Count(t => t.ConceptType == ct);
                                <button type="button" class="slot-chip @(_filterType == ct ? "active" : "")"
                                        @onclick="() => _filterType = ct">
                                    @ct (@count)
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>正規名称</th>
                                <th>ConceptType</th>
                                <th>LogicalType</th>
                                <th>Namespace</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var term in FilteredTerms())
                            {
                                var isSelected = _selectedTermId == term.Id;
                                <tr class="@(isSelected ? "table-primary" : "")" style="cursor:pointer"
                                    @onclick="() => SelectTerm(term.Id)">
                                    <td class="font-monospace small">@term.Id</td>
                                    <td class="fw-semibold">@term.CanonicalName</td>
                                    <td><span class="chip-badge chip-type">@term.ConceptType</span></td>
                                    <td class="small">
                                        @if (term.LogicalType.Kind == LogicalTypeKind.Enum)
                                        {
                                            <span>Enum [@string.Join(", ", term.LogicalType.AllowedValues)]</span>
                                        }
                                        else
                                        {
                                            <span>@term.LogicalType.Kind</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(term.Namespace ?? "-")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteTerm(term.Id)">
                                            削除
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Term Editor -->
        <div class="col-lg-5">
            @{
                var editing = GetSelectedTerm();
            }
            @if (editing is null)
            {
                <div class="slot-card text-center text-muted py-5">
                    左の一覧から語彙を選択するか、「＋ 新規語彙を追加」をクリックしてください。
                </div>
            }
            else
            {
                <div class="slot-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="fw-bold">語彙の編集</span>
                        <span class="badge bg-secondary font-monospace">@editing.Id</span>
                    </div>

                    <div class="mb-2">
                        <label class="slot-label">ID</label>
                        <input type="text" class="form-control form-control-sm font-monospace"
                               value="@editing.Id"
                               @onchange="e => RenameTermId(editing, e.Value?.ToString())" />
                    </div>

                    <div class="mb-2">
                        <label class="slot-label">正規名称 (CanonicalName)</label>
                        <input type="text" class="form-control form-control-sm"
                               value="@editing.CanonicalName"
                               @oninput="e => { editing.CanonicalName = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }" />
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="slot-label">ConceptType (7種)</label>
                            <select class="form-select form-select-sm"
                                    value="@editing.ConceptType"
                                    @onchange="e => OnConceptTypeChanged(editing, e.Value?.ToString())">
                                @foreach (var ct in Enum.GetValues<ConceptType>())
                                {
                                    <option value="@ct">@ct</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="slot-label">Namespace</label>
                            <input type="text" class="form-control form-control-sm" placeholder="例: customer.domain"
                                   value="@editing.Namespace"
                                   @oninput="e => { editing.Namespace = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString(); Workspace.NotifyChanged(); }" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="slot-label">説明 (Description)</label>
                        <textarea class="form-control form-control-sm" rows="2"
                                  value="@editing.Description"
                                  @oninput="e => { editing.Description = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }"></textarea>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <label class="slot-label">LogicalType (値ドメイン定義)</label>
                        <div class="chip-group">
                            @foreach (var kind in Enum.GetValues<LogicalTypeKind>())
                            {
                                <button type="button"
                                        class="slot-chip @(editing.LogicalType.Kind == kind ? "active" : "")"
                                        @onclick="() => OnLogicalTypeKindChanged(editing, kind)">
                                    @kind
                                </button>
                            }
                        </div>
                    </div>

                    @if (editing.LogicalType.Kind == LogicalTypeKind.Boolean)
                    {
                        <div class="small text-muted mt-2">
                            許容値: <code>true</code> / <code>false</code>（自動閉包）
                        </div>
                    }
                    else if (editing.LogicalType.Kind == LogicalTypeKind.Enum)
                    {
                        <div class="mt-3">
                            <label class="slot-label">AllowedValues (Enum 値リスト)</label>
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" class="form-control" placeholder="新しい値を入力 (例: Active)"
                                       @bind="_newEnumValue"
                                       @onkeydown="e => OnEnumInputKeyDown(e, editing)" />
                                <button type="button" class="btn btn-outline-primary" @onclick="() => AddEnumValue(editing)">
                                    追加
                                </button>
                            </div>
                            <div class="chip-group">
                                @foreach (var val in editing.LogicalType.AllowedValues.ToList())
                                {
                                    <span class="slot-chip slot-chip-value active d-inline-flex align-items-center gap-1">
                                        @val
                                        <button type="button" class="btn-close btn-close-white" style="font-size: 0.55rem;"
                                                aria-label="Remove"
                                                @onclick="() => RemoveEnumValue(editing, val)"></button>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _searchText = string.Empty;
    private ConceptType? _filterType;
    private string? _selectedTermId;
    private string _newEnumValue = string.Empty;

    protected override void OnInitialized()
    {
        Workspace.OnChange += HandleChanged;
        _selectedTermId = Workspace.Document.Glossary.FirstOrDefault()?.Id;
    }

    private void HandleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<ApprovedGlossaryTerm> FilteredTerms()
    {
        IEnumerable<ApprovedGlossaryTerm> query = Workspace.Document.Glossary;
        if (_filterType.HasValue)
        {
            query = query.Where(t => t.ConceptType == _filterType.Value);
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(t =>
                t.Id.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || t.CanonicalName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        return query;
    }

    private ApprovedGlossaryTerm? GetSelectedTerm() =>
        _selectedTermId is null
            ? null
            : Workspace.Document.Glossary.FirstOrDefault(t => string.Equals(t.Id, _selectedTermId, StringComparison.Ordinal));

    private void SelectTerm(string termId)
    {
        _selectedTermId = termId;
        _newEnumValue = string.Empty;
    }

    private void CreateNewTerm()
    {
        var idx = Workspace.Document.Glossary.Count + 1;
        var id = $"TERM-NEW-{idx:000}";
        while (Workspace.Document.Glossary.Any(t => t.Id == id))
        {
            idx++;
            id = $"TERM-NEW-{idx:000}";
        }

        var term = new ApprovedGlossaryTerm
        {
            Id = id,
            CanonicalName = $"新規語彙 {idx}",
            ConceptType = _filterType ?? ConceptType.DomainObject,
            LogicalType = new LogicalTypeDefinition { Kind = LogicalTypeKind.None }
        };

        Workspace.AddGlossaryTerm(term);
        _selectedTermId = term.Id;
    }

    private void DeleteTerm(string termId)
    {
        Workspace.DeleteGlossaryTerm(termId);
        if (_selectedTermId == termId)
        {
            _selectedTermId = Workspace.Document.Glossary.FirstOrDefault()?.Id;
        }
    }

    private void RenameTermId(ApprovedGlossaryTerm term, string? newId)
    {
        if (string.IsNullOrWhiteSpace(newId))
        {
            return;
        }

        term.Id = newId.Trim();
        _selectedTermId = term.Id;
        Workspace.NotifyChanged();
    }

    private void OnConceptTypeChanged(ApprovedGlossaryTerm term, string? typeStr)
    {
        if (Enum.TryParse<ConceptType>(typeStr, out var ct))
        {
            term.ConceptType = ct;
            Workspace.NotifyChanged();
        }
    }

    private void OnLogicalTypeKindChanged(ApprovedGlossaryTerm term, LogicalTypeKind kind)
    {
        term.LogicalType.Kind = kind;
        if (kind != LogicalTypeKind.Enum)
        {
            term.LogicalType.AllowedValues.Clear();
        }
        Workspace.NotifyChanged();
    }

    private void AddEnumValue(ApprovedGlossaryTerm term)
    {
        var trimmed = _newEnumValue.Trim();
        if (!string.IsNullOrEmpty(trimmed) && !term.LogicalType.AllowedValues.Contains(trimmed, StringComparer.Ordinal))
        {
            term.LogicalType.AllowedValues.Add(trimmed);
            _newEnumValue = string.Empty;
            Workspace.NotifyChanged();
        }
    }

    private void OnEnumInputKeyDown(KeyboardEventArgs e, ApprovedGlossaryTerm term)
    {
        if (e.Key == "Enter")
        {
            AddEnumValue(term);
        }
    }

    private void RemoveEnumValue(ApprovedGlossaryTerm term, string val)
    {
        term.LogicalType.AllowedValues.Remove(val);
        Workspace.NotifyChanged();
    }

    public void Dispose()
    {
        Workspace.OnChange -= HandleChanged;
    }
}
