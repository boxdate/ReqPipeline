@page "/"
@implements IDisposable
@inject WorkspaceStateService Workspace
@inject NavigationManager Navigation

<PageTitle>Workbench - ReqPipeline V2</PageTitle>

@{
    var isAcMode = string.Equals(Workspace.WorkbenchMode, "ac", StringComparison.Ordinal);
    var selectedAc = Workspace.GetSelectedAc();
}

<div class="wb-grid">
    <!-- ==================== LEFT PANE: TREE ==================== -->
    <aside class="wb-pane wb-pane-left">
        <div class="d-flex align-items-center justify-content-between mb-2 gap-1">
            <div style="min-width: 0;">
                <div class="wb-section-title mb-0">@(isAcMode ? "Rationale & AC Tree" : "Knowledge Graph Tree")</div>
                <div class="fw-bold small text-truncate v2-text-primary" title="@Workspace.Document.Title">
                    @Workspace.Document.Title
                </div>
            </div>
            <div class="d-flex gap-1 flex-shrink-0">
                <button type="button" class="v2-btn v2-btn-xs v2-btn-outline" title="理由 (Rationale) を追加"
                        @onclick="() => Workspace.AddRationale()">
                    <UiIcon Name="plus" Size="12" />
                    <span>理由</span>
                </button>
                @if (isAcMode)
                {
                    <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-primary" title="達成基準 (AC) を追加"
                            @onclick="() => Workspace.AddAchievementCriterion()">
                        <UiIcon Name="plus" Size="12" />
                        <span>AC</span>
                    </button>
                }
                else
                {
                    <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-primary" title="親要求を追加"
                            @onclick="() => Workspace.AddCompositeRequirement()">
                        <UiIcon Name="plus" Size="12" />
                        <span>親要求</span>
                    </button>
                }
            </div>
        </div>

        <hr class="my-2" />

        @if (isAcMode)
        {
            var renderedAcIds = new HashSet<string>(StringComparer.Ordinal);

            @foreach (var rationale in Workspace.Document.Rationales)
            {
                var linkedAcs = Workspace.Document.AchievementCriteria
                    .Where(ac => string.Equals(ac.RationaleId, rationale.Id, StringComparison.Ordinal))
                    .ToList();

                <div class="tree-rationale">
                    <div class="tree-rationale-header"
                         role="button"
                         title="@rationale.Description"
                         @onclick='() => { Workspace.SetWorkbenchMode("usdm"); Workspace.SelectRationale(rationale.Id); }'>
                        <span class="text-truncate">
                            <span class="v2-mono-id me-1">@rationale.Id</span>@rationale.Title
                        </span>
                        <button type="button" class="v2-btn v2-btn-xs v2-btn-ghost p-1" title="この理由に達成基準 (AC) を追加"
                                @onclick:stopPropagation="true"
                                @onclick="() => Workspace.AddAchievementCriterion(rationale.Id)">
                            <UiIcon Name="plus" Size="12" />
                        </button>
                    </div>

                    @if (linkedAcs.Count == 0)
                    {
                        <div class="small v2-text-muted ps-2 py-1" style="font-size: 0.74rem;">AC 未登録</div>
                    }
                    else
                    {
                        @foreach (var ac in linkedAcs)
                        {
                            renderedAcIds.Add(ac.Id);
                            @RenderAcTreeNode(ac)
                        }
                    }
                </div>
            }

            var orphanAcs = Workspace.Document.AchievementCriteria
                .Where(ac => !renderedAcIds.Contains(ac.Id))
                .ToList();
            @if (orphanAcs.Count > 0)
            {
                <div class="tree-rationale">
                    <div class="tree-rationale-header tree-rationale-header-danger">
                        <span class="d-inline-flex align-items-center gap-1">
                            <UiIcon Name="alert-triangle" Size="13" />
                            <span>根拠未設定 AC (AC-ERR-001)</span>
                        </span>
                    </div>
                    @foreach (var ac in orphanAcs)
                    {
                        @RenderAcTreeNode(ac)
                    }
                </div>
            }
        }
        else
        {
        var topLevelReqs = Workspace.Document.Requirements
            .Where(r => string.IsNullOrWhiteSpace(r.ParentRequirementId))
            .ToList();
        var renderedTopIds = new HashSet<string>(StringComparer.Ordinal);

        @foreach (var rationale in Workspace.Document.Rationales)
        {
            var linked = topLevelReqs
                .Where(r => r.RationaleRefs.Contains(rationale.Id, StringComparer.Ordinal))
                .ToList();
            var isRatSelected = string.Equals(Workspace.SelectedRationaleId, rationale.Id, StringComparison.Ordinal);

            <div class="tree-rationale">
                <div class="tree-rationale-header @(isRatSelected ? "selected" : "")"
                     role="button"
                     title="@rationale.Description"
                     @onclick="() => Workspace.SelectRationale(rationale.Id)">
                    <span class="text-truncate">
                        <span class="v2-mono-id me-1">@rationale.Id</span>@rationale.Title
                    </span>
                    <button type="button" class="v2-btn v2-btn-xs v2-btn-ghost p-1" title="この理由に親要求を追加"
                            @onclick:stopPropagation="true"
                            @onclick="() => Workspace.AddCompositeRequirement(rationale.Id)">
                        <UiIcon Name="plus" Size="12" />
                    </button>
                </div>

                @foreach (var comp in linked)
                {
                    renderedTopIds.Add(comp.Id);
                    @RenderTreeNode(comp, isChild: false)

                    @foreach (var child in Workspace.Document.Requirements.Where(c => c.ParentRequirementId == comp.Id))
                    {
                        @RenderTreeNode(child, isChild: true)
                    }
                }
            </div>
        }

        var orphans = topLevelReqs.Where(r => !renderedTopIds.Contains(r.Id)).ToList();
        @if (orphans.Count > 0)
        {
            <div class="tree-rationale">
                <div class="tree-rationale-header tree-rationale-header-danger">
                    <span class="d-inline-flex align-items-center gap-1">
                        <UiIcon Name="alert-triangle" Size="13" />
                        <span>未紐付け要求 (LINT-006)</span>
                    </span>
                </div>
                @foreach (var orphan in orphans)
                {
                    @RenderTreeNode(orphan, isChild: false)
                    @foreach (var child in Workspace.Document.Requirements.Where(c => c.ParentRequirementId == orphan.Id))
                    {
                        @RenderTreeNode(child, isChild: true)
                    }
                }
            </div>
        }
        }
    </aside>

    <!-- ==================== CENTER PANE: STRUCTURED SLOT EDITOR / AC EDITOR ==================== -->
    <section class="wb-pane wb-pane-center">
        <div class="wb-mode-bar">
            <div class="v2-segment" role="tablist" aria-label="Workbench Mode">
                <button type="button"
                        role="tab"
                        aria-selected="@(!isAcMode)"
                        class="v2-segment-item @(!isAcMode ? "active" : "")"
                        @onclick='() => Workspace.SetWorkbenchMode("usdm")'>
                    <span>要求 (USDM)</span>
                    <span class="v2-mono-id">@Workspace.Document.Requirements.Count</span>
                </button>
                <button type="button"
                        role="tab"
                        aria-selected="@isAcMode"
                        class="v2-segment-item @(isAcMode ? "active" : "")"
                        @onclick='() => Workspace.SetWorkbenchMode("ac")'>
                    <span>達成基準 (AC)</span>
                    <span class="v2-mono-id">@Workspace.Document.AchievementCriteria.Count</span>
                </button>
            </div>

            @if (isAcMode)
            {
                <button type="button" class="v2-btn v2-btn-xs v2-btn-primary" @onclick="() => Workspace.AddAchievementCriterion()">
                    <UiIcon Name="plus" Size="12" />
                    <span>達成基準 (AC) を追加</span>
                </button>
            }
        </div>

        @{
            var selected = Workspace.GetSelectedRequirement();
            var selectedRationale = Workspace.GetSelectedRationale();
        }

        @if (isAcMode)
        {
            @if (Workspace.Document.AchievementCriteria.Count == 0)
            {
                <EmptyState Icon="clipboard-check"
                            Title="達成基準（AC）がまだ登録されていません"
                            Description="WDD（Why Driven Development）の達成基準を作成し、実現側の親要求（Composite）と検証側の E2E（Journey）を多対多で紐づけましょう。">
                    <Actions>
                        <button type="button" class="v2-btn v2-btn-sm v2-btn-primary" @onclick="() => Workspace.AddAchievementCriterion()">
                            <UiIcon Name="plus" Size="13" />
                            <span>最初の達成基準 (AC) を作成</span>
                        </button>
                        @if (Workspace.Document.Rationales.Count == 0)
                        {
                            <button type="button" class="v2-btn v2-btn-sm v2-btn-outline" @onclick="() => { Workspace.AddRationale(); }">
                                <UiIcon Name="plus" Size="13" />
                                <span>先に Rationale を作成</span>
                            </button>
                        }
                    </Actions>
                </EmptyState>
            }
            else if (selectedAc is null)
            {
                <EmptyState Icon="clipboard-check"
                            Compact="true"
                            Title="編集する達成基準（AC）を選択してください"
                            Description="左のツリーから AC を選択するか、新しく作成してください。" />
            }
            else
            {
                var acTrace = AcTraceabilityAnalyzer.Analyze(Workspace.Document, selectedAc.Id);
                var allComposites = Workspace.Document.Requirements
                    .Where(r => r.NodeKind == RequirementNodeKind.Composite)
                    .OrderBy(r => r.Id, StringComparer.Ordinal)
                    .ToList();
                var filteredComposites = string.IsNullOrWhiteSpace(_acCompositeSearch)
                    ? allComposites
                    : allComposites.Where(c =>
                        c.Id.Contains(_acCompositeSearch, StringComparison.OrdinalIgnoreCase)
                        || c.Title.Contains(_acCompositeSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="v2-badge v2-badge-outline">AchievementCriterion (AC)</span>
                        <span class="v2-mono-id fw-bold">@selectedAc.Id</span>
                    </div>
                    <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-danger"
                            @onclick="() => Workspace.DeleteAchievementCriterion(selectedAc.Id)">
                        <UiIcon Name="trash" Size="13" />
                        <span>削除</span>
                    </button>
                </div>

                <!-- 1. 基本情報 -->
                <div class="slot-card">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="slot-label">AC ID</label>
                            <input type="text" class="form-control form-control-sm font-monospace"
                                   value="@selectedAc.Id"
                                   @onchange="e => RenameAcId(selectedAc, e.Value?.ToString())" />
                        </div>
                        <div class="col-md-8">
                            <label class="slot-label">
                                親 Rationale (US / Why)
                                <span class="slot-type-hint">必須 (AC-ERR-001)</span>
                            </label>
                            <select class="form-select form-select-sm"
                                    value="@selectedAc.RationaleId"
                                    @onchange="e => { selectedAc.RationaleId = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }">
                                <option value="">-- Rationale を選択 --</option>
                                @foreach (var rat in Workspace.Document.Rationales)
                                {
                                    <option value="@rat.Id">[@rat.Id] @rat.Title</option>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedAc.RationaleId)
                                    && !Workspace.Document.Rationales.Any(r => string.Equals(r.Id, selectedAc.RationaleId, StringComparison.Ordinal)))
                                {
                                    <option value="@selectedAc.RationaleId">[未定義] @selectedAc.RationaleId</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="slot-label">
                                タイトル (達成基準・観点名)
                                <span class="slot-type-hint">必須 (AC-ERR-004)</span>
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="例: 通常施錠・解錠とアンサーバック通知"
                                   value="@selectedAc.Title"
                                   @oninput="e => { selectedAc.Title = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }" />
                        </div>
                        <div class="col-12">
                            <label class="slot-label">達成基準の説明 (Description)</label>
                            <textarea class="form-control form-control-sm v2-prose" rows="3"
                                      placeholder="WDD で合意した達成基準本文や完了条件を記述"
                                      value="@selectedAc.Description"
                                      @oninput="e => { selectedAc.Description = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }"></textarea>
                        </div>
                    </div>
                </div>

                <!-- 2. 実現側: 親要求 (Composite) 紐づけ -->
                <div class="slot-card">
                    <div class="slot-card-header">
                        <label class="slot-label mb-0">
                            実現側: 親要求 (Composite) 紐づけ
                            <span class="slot-type-hint">多対多可 · AC-WARN-001</span>
                        </label>
                        <span class="v2-badge @(selectedAc.LinkedCompositeIds.Count > 0 ? "v2-badge-primary" : "v2-badge-warning")">
                            @selectedAc.LinkedCompositeIds.Count 件選択中
                        </span>
                    </div>

                    @if (allComposites.Count == 0)
                    {
                        <div class="small v2-text-muted">
                            親要求（Composite）がまだありません。「要求 (USDM)」モードで親要求を作成してください。
                        </div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="親要求を ID・タイトルで絞り込み..."
                                   @bind="_acCompositeSearch" @bind:event="oninput" />
                        </div>
                        <div class="v2-checklist-scroll">
                            @foreach (var comp in filteredComposites)
                            {
                                var isChecked = selectedAc.LinkedCompositeIds.Contains(comp.Id, StringComparer.Ordinal);
                                <label class="v2-checklist-item @(isChecked ? "checked" : "")">
                                    <input type="checkbox"
                                           class="form-check-input mt-1 flex-shrink-0"
                                           checked="@isChecked"
                                           @onchange="e => ToggleAcComposite(selectedAc, comp.Id, e.Value is bool b && b)" />
                                    <span class="flex-grow-1" style="min-width: 0;">
                                        <span class="v2-mono-id me-1">@comp.Id</span>
                                        <span class="fw-semibold v2-text-primary">@comp.Title</span>
                                        @if (comp.RationaleRefs.Count > 0)
                                        {
                                            <span class="v2-mono-id ms-1">(@string.Join(", ", comp.RationaleRefs))</span>
                                        }
                                    </span>
                                </label>
                            }
                            @if (filteredComposites.Count == 0)
                            {
                                <div class="small v2-text-muted p-2 text-center">一致する親要求がありません。</div>
                            }
                        </div>
                    }
                </div>

                <!-- 3. 検証側: E2E (Journey) 紐づけ -->
                <div class="slot-card">
                    <div class="slot-card-header">
                        <label class="slot-label mb-0">
                            検証側: E2E シナリオ (Journey) 紐づけ
                            <span class="slot-type-hint">多対多可 · AC-WARN-002</span>
                        </label>
                        <span class="v2-badge @(selectedAc.LinkedJourneyIds.Count > 0 ? "v2-badge-success" : "v2-badge-outline")">
                            @selectedAc.LinkedJourneyIds.Count 件選択中
                        </span>
                    </div>

                    @if (Workspace.Document.Journeys.Count == 0)
                    {
                        <div class="small v2-text-muted">
                            Journey が未登録です。<button type="button" class="v2-btn-link" @onclick='() => Navigation.NavigateTo("/journey")'>Journey ビューで作成</button>するか、下の手動検証観点メモを記入してください。
                        </div>
                    }
                    else
                    {
                        <div class="v2-checklist-scroll">
                            @foreach (var jrn in Workspace.Document.Journeys.OrderBy(j => j.Id, StringComparer.Ordinal))
                            {
                                var isChecked = selectedAc.LinkedJourneyIds.Contains(jrn.Id, StringComparer.Ordinal);
                                <label class="v2-checklist-item @(isChecked ? "checked" : "")">
                                    <input type="checkbox"
                                           class="form-check-input mt-1 flex-shrink-0"
                                           checked="@isChecked"
                                           @onchange="e => ToggleAcJourney(selectedAc, jrn.Id, e.Value is bool b && b)" />
                                    <span class="flex-grow-1" style="min-width: 0;">
                                        <span class="v2-mono-id me-1">@jrn.Id</span>
                                        <span class="fw-semibold v2-text-primary">@jrn.Title</span>
                                        <span class="small v2-text-muted ms-1">(@jrn.Steps.Count ステップ)</span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>

                <!-- 4. 観点タグ & 手動検証観点メモ -->
                <div class="slot-card">
                    <div class="mb-3">
                        <label class="slot-label">観点タグ (ViewpointTags)</label>
                        <div class="d-flex gap-1 mb-2">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="例: 正, 禁, 安全, 物理:連打（カンマ区切り可）"
                                   @bind="_newAcTag"
                                   @onkeydown="e => OnAcTagKeyDown(e, selectedAc)" />
                            <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-primary"
                                    @onclick="() => AddAcTags(selectedAc)">
                                <UiIcon Name="plus" Size="12" />
                                <span>追加</span>
                            </button>
                        </div>
                        @if (selectedAc.ViewpointTags.Count > 0)
                        {
                            <div class="chip-group">
                                @foreach (var tag in selectedAc.ViewpointTags.ToList())
                                {
                                    <span class="v2-badge v2-badge-outline">
                                        <span>@tag</span>
                                        <button type="button" class="v2-btn v2-btn-ghost p-0" style="color: inherit;"
                                                aria-label="タグを削除"
                                                @onclick="() => RemoveAcTag(selectedAc, tag)">
                                            <UiIcon Name="x" Size="11" />
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div>
                        <label class="slot-label">
                            手動検証観点メモ (ManualVerificationNote)
                            <span class="slot-type-hint">任意 · 離散論理外の物理・運用観点</span>
                        </label>
                        <textarea class="form-control form-control-sm v2-prose" rows="2"
                                  placeholder="例: チャタリング・同時押し時の実機応答確認、500ms 以内のハードウェア遮断確認"
                                  value="@selectedAc.ManualVerificationNote"
                                  @oninput="e => { selectedAc.ManualVerificationNote = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }"></textarea>
                    </div>
                </div>

                <!-- 5. 関連・横飛び火プレビュー (AcTraceabilityAnalyzer) -->
                <div class="slot-card">
                    <div class="slot-card-header">
                        <span class="slot-label mb-0">関連・横飛び火プレビュー（自動導出）</span>
                        <span class="v2-mono-id">AcTraceabilityAnalyzer</span>
                    </div>

                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2 small">
                        <span class="v2-badge v2-badge-outline">
                            配下 Atomic: @acTrace.ResolvedAtomicIds.Count 件
                        </span>
                        <span class="v2-badge v2-badge-outline">
                            参照 Glossary: @acTrace.ReferencedTermIds.Count 語彙
                        </span>
                        <span class="v2-badge @(acTrace.LateralImpactAcLinks.Count > 0 ? "v2-badge-warning" : "v2-badge-outline")">
                            横飛び火候補: @acTrace.LateralImpactAcLinks.Count 件
                        </span>
                    </div>

                    @if (acTrace.ResolvedAtomicIds.Count > 0)
                    {
                        <div class="mb-3">
                            <div class="small v2-text-muted mb-1">解決された Atomic 要求（クリックで USDM エディタへ移動）:</div>
                            <div class="chip-group">
                                @foreach (var atomicId in acTrace.ResolvedAtomicIds)
                                {
                                    <button type="button"
                                            class="v2-btn v2-btn-xs v2-btn-outline font-monospace"
                                            @onclick="() => Workspace.SelectRequirement(atomicId)">
                                        <span>@atomicId</span>
                                        <UiIcon Name="external-link" Size="11" />
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div>
                        <div class="small v2-text-muted mb-1">共有 Glossary 経由の横飛び火候補（他 AC）:</div>
                        @if (acTrace.LateralImpactAcLinks.Count == 0)
                        {
                            <div class="small v2-text-muted">同じ状態・ドメイン語彙を共有する他の AC は検出されていません。</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var link in acTrace.LateralImpactAcLinks)
                                {
                                    var sharedLabels = string.Join(", ", link.SharedTerms.Select(t => t.DisplayName));
                                    <button type="button"
                                            class="v2-lateral-badge"
                                            title="共有語彙: @sharedLabels"
                                            @onclick="() => Workspace.SelectAc(link.TargetAcId, switchToAcMode: true)">
                                        <UiIcon Name="git-branch" Size="12" />
                                        <span class="font-monospace">@link.TargetAcId</span>
                                        <span>@link.TargetAcTitle</span>
                                        <span class="v2-text-muted" style="font-weight: 500;">(@sharedLabels)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (selectedRationale is not null)
        {
            var linkedParents = Workspace.Document.Requirements
                .Where(r => string.IsNullOrWhiteSpace(r.ParentRequirementId)
                            && r.RationaleRefs.Contains(selectedRationale.Id, StringComparer.Ordinal))
                .ToList();

            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="v2-badge v2-badge-outline">Rationale (理由)</span>
                    <span class="v2-mono-id fw-bold">@selectedRationale.Id</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="v2-btn v2-btn-sm v2-btn-primary"
                            @onclick="() => Workspace.AddCompositeRequirement(selectedRationale.Id)">
                        <UiIcon Name="plus" Size="13" />
                        <span>この理由に親要求を追加</span>
                    </button>
                    <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-danger"
                            @onclick="() => Workspace.DeleteRationale(selectedRationale.Id)">
                        <UiIcon Name="trash" Size="13" />
                        <span>削除</span>
                    </button>
                </div>
            </div>

            <div class="slot-card">
                <div class="small v2-text-muted mb-3 v2-prose">
                    本来は上流（WDD 等）で導出した理由をインポートして利用しますが、テスト・試作時の微修正や追加をここで行えます。
                </div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="slot-label">タイトル</label>
                        <input type="text" class="form-control form-control-sm"
                               value="@selectedRationale.Title"
                               @oninput="e => { selectedRationale.Title = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }" />
                    </div>
                    <div class="col-md-4">
                        <label class="slot-label">ステークホルダー</label>
                        <input type="text" class="form-control form-control-sm" placeholder="例: 営業部門"
                               value="@selectedRationale.Stakeholder"
                               @oninput="e => { selectedRationale.Stakeholder = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }" />
                    </div>
                    <div class="col-12">
                        <label class="slot-label">理由本文 (Description)</label>
                        <textarea class="form-control form-control-sm v2-prose" rows="3"
                                  placeholder="なぜこの要求群が必要か（背景・目的・課題）を記述"
                                  value="@selectedRationale.Description"
                                  @oninput="e => { selectedRationale.Description = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }"></textarea>
                    </div>
                </div>
            </div>

            <div class="slot-card">
                <div class="slot-card-header">
                    <span class="slot-label mb-0">紐付く親要求 (@linkedParents.Count 件)</span>
                </div>
                @if (linkedParents.Count == 0)
                {
                    <div class="small v2-text-muted">まだ親要求が紐付いていません。</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var p in linkedParents)
                        {
                            <button type="button" class="v2-list-row"
                                    @onclick="() => Workspace.SelectRequirement(p.Id)">
                                <span class="fw-semibold small">
                                    <span class="v2-mono-id me-1">@p.Id</span>@p.Title
                                </span>
                                <span class="v2-btn-link">
                                    <span>開く</span>
                                    <UiIcon Name="arrow-right" Size="13" />
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else if (selected is null)
        {
            @if (Workspace.Document.Rationales.Count == 0 && Workspace.Document.Requirements.Count == 0)
            {
                <EmptyState Icon="file-text"
                            Title="まだ根拠（US / Rationale）がありません"
                            Description="まずは要求の背景となる根拠（Rationale）を作成するか、Glossary でドメイン語彙を定義して仕様設計を始めましょう。">
                    <Actions>
                        <button type="button" class="v2-btn v2-btn-sm v2-btn-primary" @onclick="() => Workspace.AddRationale()">
                            <UiIcon Name="plus" Size="13" />
                            <span>最初の Rationale を作成</span>
                        </button>
                        <button type="button" class="v2-btn v2-btn-sm v2-btn-outline" @onclick='() => Navigation.NavigateTo("/glossary")'>
                            <UiIcon Name="book-open" Size="13" />
                            <span>Glossary から語彙を定義</span>
                        </button>
                    </Actions>
                </EmptyState>
            }
            else
            {
                <EmptyState Icon="file-text"
                            Compact="true"
                            Title="編集するノードを選択してください"
                            Description="左のツリーから Rationale または要求ノードを選択するか、新しく親要求を追加してください。">
                    <Actions>
                        <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-primary" @onclick="() => Workspace.AddCompositeRequirement()">
                            <UiIcon Name="plus" Size="13" />
                            <span>親要求を追加</span>
                        </button>
                    </Actions>
                </EmptyState>
            }
        }
        else if (selected.NodeKind == RequirementNodeKind.Composite)
        {
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="v2-badge v2-badge-outline">Composite (親要求)</span>
                    <span class="v2-mono-id fw-bold">@selected.Id</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="v2-btn v2-btn-sm v2-btn-primary" @onclick="() => Workspace.AddAtomicChild(selected)">
                        <UiIcon Name="plus" Size="13" />
                        <span>子要求（動作）を追加</span>
                    </button>
                    <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-danger" @onclick="() => Workspace.DeleteRequirement(selected.Id)">
                        <UiIcon Name="trash" Size="13" />
                        <span>削除</span>
                    </button>
                </div>
            </div>

            <div class="slot-card">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="slot-label">タイトル</label>
                        <input type="text" class="form-control form-control-sm"
                               value="@selected.Title"
                               @oninput="e => { selected.Title = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }" />
                    </div>
                    <div class="col-md-4">
                        <label class="slot-label">Namespace</label>
                        <input type="text" class="form-control form-control-sm" placeholder="例: customer.crud"
                               value="@selected.Namespace"
                               @oninput="e => { selected.Namespace = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }" />
                    </div>
                    <div class="col-12">
                        <label class="slot-label">
                            親要求の文章（分解前の要求文）
                            <span class="slot-type-hint">自然言語で記述可</span>
                        </label>
                        <textarea class="form-control form-control-sm v2-prose" rows="3"
                                  placeholder="例: 利用者が新規顧客を登録し、一覧から選択して詳細画面へ遷移できること。"
                                  value="@selected.Summary"
                                  @oninput="e => { selected.Summary = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }"></textarea>
                    </div>
                </div>
            </div>

            <div class="slot-card">
                <label class="slot-label">
                    RationaleRefs (理由の紐付け)
                    <span class="slot-type-hint">最上位要求は1つ以上必須 (LINT-006)</span>
                </label>
                <div class="chip-group mt-2">
                    @foreach (var rat in Workspace.Document.Rationales)
                    {
                        var isLinked = selected.RationaleRefs.Contains(rat.Id, StringComparer.Ordinal);
                        <button type="button"
                                class="slot-chip @(isLinked ? "active" : "")"
                                @onclick="() => ToggleRationaleRef(selected, rat.Id)">
                            @if (isLinked)
                            {
                                <UiIcon Name="check-circle" Size="13" />
                            }
                            <span>[@rat.Id] @rat.Title</span>
                        </button>
                    }
                </div>
            </div>

            <div class="slot-card">
                <div class="slot-card-header">
                    <span class="slot-label mb-0">
                        分解前の共通要素（子要求へ自動引き継ぎ）
                        <span class="slot-type-hint">Context / Actor / Trigger / Subject</span>
                    </span>
                </div>

                <div class="mb-3">
                    <label class="slot-label">既定の EARS パターン</label>
                    <div class="chip-group">
                        @foreach (var pattern in Enum.GetValues<EarsEntryPattern>())
                        {
                            <button type="button"
                                    class="slot-chip @(selected.EarsPattern == pattern ? "active" : "")"
                                    @onclick="() => { selected.EarsPattern = pattern; Workspace.NotifyChanged(); }">
                                @FormatEarsLabel(pattern)
                            </button>
                        }
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="slot-label">対象システム <span class="slot-type-hint">System</span></label>
                        <select class="form-select form-select-sm"
                                value="@(selected.SubjectSystemRef ?? "")"
                                @onchange="e => { selected.SubjectSystemRef = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                            <option value="">-- 未選択 --</option>
                            @foreach (var sys in Workspace.GetGlossaryByTypes(ConceptType.System))
                            {
                                <option value="@sys.Id">@FormatTermOption(sys)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="slot-label">共通アクター <span class="slot-type-hint">Actor</span></label>
                        <select class="form-select form-select-sm"
                                value="@(selected.ActorRef ?? "")"
                                @onchange="e => { selected.ActorRef = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                            <option value="">-- 指定なし --</option>
                            @foreach (var actor in Workspace.GetGlossaryByTypes(ConceptType.Actor))
                            {
                                <option value="@actor.Id">@FormatTermOption(actor)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="slot-label">共通トリガー <span class="slot-type-hint">Event</span></label>
                        <select class="form-select form-select-sm"
                                value="@(selected.TriggerEventRef ?? "")"
                                @onchange="e => { selected.TriggerEventRef = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                            <option value="">-- 指定なし --</option>
                            @foreach (var evt in Workspace.GetGlossaryByTypes(ConceptType.Event))
                            {
                                <option value="@evt.Id">@FormatTermOption(evt)</option>
                            }
                        </select>
                    </div>
                </div>

                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="slot-label mb-0">共通の前提条件 (Preconditions)</span>
                        <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-primary"
                                @onclick="() => AddPrecondition(selected)">
                            <UiIcon Name="plus" Size="12" />
                            <span>条件追加</span>
                        </button>
                    </div>
                    @{
                        var parentStateTerms = Workspace.GetGlossaryByTypes(ConceptType.StateVariable, ConceptType.LifecycleState);
                    }
                    @if (selected.Preconditions.Count == 0)
                    {
                        <div class="small v2-text-muted">共通の前提条件はありません。</div>
                    }
                    else
                    {
                        @for (var i = 0; i < selected.Preconditions.Count; i++)
                        {
                            var idx = i;
                            var clause = selected.Preconditions[idx];
                            var allowedVals = Workspace.GetAllowedValues(clause.StateTermRef);
                            <div class="v2-subcard mb-2">
                                <div class="row g-2 align-items-center mb-2">
                                    <div class="col-md-6">
                                        <select class="form-select form-select-sm"
                                                value="@clause.StateTermRef"
                                                @onchange="e => OnPreconditionStateChanged(clause, e.Value?.ToString())">
                                            <option value="">-- 状態語彙を選択 --</option>
                                            @foreach (var st in parentStateTerms)
                                            {
                                                <option value="@st.Id">@FormatTermOption(st) (@st.ConceptType)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <select class="form-select form-select-sm"
                                                value="@clause.Operator"
                                                @onchange="e => OnPreconditionOperatorChanged(clause, e.Value?.ToString())">
                                            @foreach (var op in Enum.GetValues<ComparisonOperator>())
                                            {
                                                <option value="@op">@op</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-danger" title="条件を削除"
                                                @onclick="() => { selected.Preconditions.RemoveAt(idx); Workspace.NotifyChanged(); }">
                                            <UiIcon Name="trash" Size="12" />
                                        </button>
                                    </div>
                                </div>
                                <div class="chip-group">
                                    @foreach (var val in allowedVals)
                                    {
                                        var activeVal = clause.ExpectedValues.Contains(val, StringComparer.Ordinal);
                                        <button type="button"
                                                class="slot-chip slot-chip-value @(activeVal ? "active" : "")"
                                                @onclick="() => ToggleExpectedValue(clause, val)">
                                            @FormatValueOption(clause.StateTermRef, val)
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="slot-card">
                <div class="slot-card-header">
                    <span class="slot-label mb-0">連続した振る舞いフロー (子要求ステップ)</span>
                    <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-primary" @onclick="() => Workspace.AddAtomicChild(selected)">
                        <UiIcon Name="plus" Size="12" />
                        <span>子要求（動作）を追加</span>
                    </button>
                </div>
                @{
                    var children = Workspace.Document.Requirements
                        .Where(c => c.ParentRequirementId == selected.Id)
                        .ToList();
                }
                @if (children.Count == 0)
                {
                    <div class="v2-alert v2-alert-danger">
                        <UiIcon Name="x-circle" Size="15" />
                        <span>まだ子要求へ分解されていません（LINT-004）。「子要求（動作）を追加」から連続する振る舞いステップを追加してください。</span>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @for (var stepIdx = 0; stepIdx < children.Count; stepIdx++)
                        {
                            var child = children[stepIdx];
                            var stepNum = stepIdx + 1;
                            <div class="v2-subcard">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="v2-badge v2-badge-neutral">Step @stepNum</span>
                                        <span class="v2-mono-id">@child.Id</span>
                                        <span class="fw-semibold small v2-text-primary">@child.Title</span>
                                        <span class="v2-badge v2-badge-outline">@child.EarsPattern</span>
                                        @if (child.Behavior is not null)
                                        {
                                            var childDef = Workspace.FindBehaviorDefinition(child.Behavior.BehaviorDefRef);
                                            <span class="v2-badge v2-badge-outline">
                                                @(childDef is not null ? childDef.JapaneseLabel : child.Behavior.BehaviorDefRef)
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                        <button type="button" class="v2-btn v2-btn-xs v2-btn-outline"
                                                disabled="@(stepIdx == 0)"
                                                title="上へ移動"
                                                @onclick="() => Workspace.MoveChildRequirement(selected.Id, child.Id, -1)">
                                            <UiIcon Name="chevron-up" Size="13" />
                                        </button>
                                        <button type="button" class="v2-btn v2-btn-xs v2-btn-outline"
                                                disabled="@(stepIdx == children.Count - 1)"
                                                title="下へ移動"
                                                @onclick="() => Workspace.MoveChildRequirement(selected.Id, child.Id, 1)">
                                            <UiIcon Name="chevron-down" Size="13" />
                                        </button>
                                        <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-primary"
                                                @onclick="() => Workspace.SelectRequirement(child.Id)">
                                            <span>編集</span>
                                            <UiIcon Name="arrow-right" Size="12" />
                                        </button>
                                    </div>
                                </div>
                                <div class="small v2-text-secondary v2-prose mt-1 ps-1">
                                    @Workspace.RenderJapanesePreview(child)
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- ATOMIC REQUIREMENT EDITOR -->
            var pendingEscape = Workspace.GetPendingEscape(selected.Id);
            var isEscapeMode = selected.Behavior is null && pendingEscape is not null;

            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="v2-badge v2-badge-outline">Atomic (子要求)</span>
                    <span class="v2-mono-id fw-bold">@selected.Id</span>
                    @if (!string.IsNullOrWhiteSpace(selected.ParentRequirementId))
                    {
                        <button type="button" class="v2-btn-link"
                                @onclick="() => Workspace.SelectRequirement(selected.ParentRequirementId)">
                            親: @selected.ParentRequirementId
                        </button>
                    }
                </div>
                <div class="d-flex gap-2">
                    @if (!isEscapeMode)
                    {
                        <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-warning"
                                @onclick="() => ActivateEscapeHatch(selected)">
                            <UiIcon Name="alert-triangle" Size="13" />
                            <span>自由記述（Escape）へ退避</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-success"
                                @onclick="() => Workspace.ReturnToStructuredSlot(selected)">
                            <UiIcon Name="check-circle" Size="13" />
                            <span>構造化スロットへ戻る</span>
                        </button>
                    }
                    <button type="button" class="v2-btn v2-btn-sm v2-btn-outline-danger"
                            @onclick="() => Workspace.DeleteRequirement(selected.Id)">
                        <UiIcon Name="trash" Size="13" />
                        <span>削除</span>
                    </button>
                </div>
            </div>

            <!-- Basic Metadata -->
            <div class="slot-card">
                <div class="row g-2">
                    <div class="col-md-8">
                        <label class="slot-label">タイトル</label>
                        <input type="text" class="form-control form-control-sm"
                               value="@selected.Title"
                               @oninput="e => { selected.Title = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }" />
                    </div>
                    <div class="col-md-4">
                        <label class="slot-label">Namespace</label>
                        <input type="text" class="form-control form-control-sm" placeholder="例: customer.crud"
                               value="@selected.Namespace"
                               @oninput="e => { selected.Namespace = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }" />
                    </div>
                </div>
            </div>

            @if (isEscapeMode && pendingEscape is not null)
            {
                <div class="escape-box mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                        <span class="fw-bold v2-text-warning d-inline-flex align-items-center gap-1">
                            <UiIcon Name="alert-triangle" Size="15" />
                            <span>Escape Hatch (自由記述レコード: @pendingEscape.Id)</span>
                        </span>
                        <span class="v2-badge v2-badge-warning">PENDING (LINT-007 承認待ち)</span>
                    </div>
                    <p class="small v2-text-secondary v2-prose mb-3">
                        構造化スロットで表現できない要件を一時退避しています。承認ゲートで <code>LINT-007</code> 警告が表示されます。
                    </p>
                    <div class="mb-3">
                        <label class="slot-label">退避理由 (EscapeReason)</label>
                        <select class="form-select form-select-sm"
                                value="@pendingEscape.Reason"
                                @onchange="e => OnEscapeReasonChanged(pendingEscape, e.Value?.ToString())">
                            @foreach (var reason in Enum.GetValues<EscapeReason>())
                            {
                                <option value="@reason">@FormatEscapeReason(reason)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="slot-label">自由記述テキスト</label>
                        <textarea class="form-control form-control-sm v2-prose" rows="3"
                                  placeholder="例: API応答は99パーセンタイルで200ms以内であること。"
                                  value="@pendingEscape.FreeText"
                                  @oninput="e => { pendingEscape.FreeText = e.Value?.ToString() ?? string.Empty; Workspace.NotifyChanged(); }"></textarea>
                    </div>
                </div>
            }
            else
            {
                <!-- EARS 5-PATTERN SELECTOR -->
                <div class="slot-card">
                    <label class="slot-label">1. EARS パターン選択 (入口)</label>
                    <div class="chip-group">
                        @foreach (var pattern in Enum.GetValues<EarsEntryPattern>())
                        {
                            <button type="button"
                                    class="slot-chip @(selected.EarsPattern == pattern ? "active" : "")"
                                    @onclick="() => SelectEarsPattern(selected, pattern)">
                                @FormatEarsLabel(pattern)
                            </button>
                        }
                    </div>
                </div>

                <!-- CONTEXT / PRECONDITIONS SLOT -->
                @if (ShowsPreconditions(selected.EarsPattern))
                {
                    <div class="slot-card">
                        <div class="slot-card-header">
                            <span class="slot-label mb-0">
                                2. 前提条件・状態 (Preconditions)
                                <span class="slot-type-hint">StateVariable / LifecycleState</span>
                            </span>
                            <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-primary"
                                    @onclick="() => AddPrecondition(selected)">
                                <UiIcon Name="plus" Size="12" />
                                <span>条件追加</span>
                            </button>
                        </div>

                        @{
                            var stateTerms = Workspace.GetGlossaryByTypes(ConceptType.StateVariable, ConceptType.LifecycleState);
                        }

                        @if (selected.Preconditions.Count == 0)
                        {
                            <div class="small v2-text-muted">前提条件はありません（任意または必要に応じて「条件追加」）。</div>
                        }
                        else
                        {
                            @for (var i = 0; i < selected.Preconditions.Count; i++)
                            {
                                var idx = i;
                                var clause = selected.Preconditions[idx];
                                var allowedVals = Workspace.GetAllowedValues(clause.StateTermRef);

                                <div class="v2-subcard mb-2">
                                    <div class="row g-2 align-items-center mb-2">
                                        <div class="col-md-6">
                                            <select class="form-select form-select-sm"
                                                    value="@clause.StateTermRef"
                                                    @onchange="e => OnPreconditionStateChanged(clause, e.Value?.ToString())">
                                                <option value="">-- 状態語彙を選択 --</option>
                                                @foreach (var st in stateTerms)
                                                {
                                                    <option value="@st.Id">@FormatTermOption(st) (@st.ConceptType)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <select class="form-select form-select-sm"
                                                    value="@clause.Operator"
                                                    @onchange="e => OnPreconditionOperatorChanged(clause, e.Value?.ToString())">
                                                @foreach (var op in Enum.GetValues<ComparisonOperator>())
                                                {
                                                    <option value="@op">@op</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <button type="button" class="v2-btn v2-btn-xs v2-btn-outline-danger" title="条件を削除"
                                                    @onclick="() => { selected.Preconditions.RemoveAt(idx); Workspace.NotifyChanged(); }">
                                                <UiIcon Name="trash" Size="12" />
                                            </button>
                                        </div>
                                    </div>
                                    @{
                                        var stateMetaHint = GetTermMetadataHint(clause.StateTermRef);
                                    }
                                    @if (!string.IsNullOrEmpty(stateMetaHint))
                                    {
                                        <div class="small v2-text-secondary d-flex align-items-center gap-1 mb-1">
                                            <UiIcon Name="info" Size="13" />
                                            <span>@stateMetaHint</span>
                                        </div>
                                    }

                                    <div>
                                        <span class="small v2-text-muted d-block mb-1">許容値 (LogicalType閉包):</span>
                                        @if (allowedVals.Count == 0)
                                        {
                                            <span class="small v2-text-danger d-inline-flex align-items-center gap-1">
                                                <UiIcon Name="alert-triangle" Size="13" />
                                                <span>選択した語彙に Boolean / Enum 定義がありません (LINT-003)</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="chip-group">
                                                @foreach (var val in allowedVals)
                                                {
                                                    var activeVal = clause.ExpectedValues.Contains(val, StringComparer.Ordinal);
                                                    <button type="button"
                                                            class="slot-chip slot-chip-value @(activeVal ? "active" : "")"
                                                            @onclick="() => ToggleExpectedValue(clause, val)">
                                                        @FormatValueOption(clause.StateTermRef, val)
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                <!-- ACTOR & TRIGGER SLOT -->
                @if (ShowsTrigger(selected.EarsPattern))
                {
                    <div class="slot-card">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="slot-label">
                                    アクター (ActorRef)
                                    <span class="slot-type-hint">Actor</span>
                                </label>
                                <select class="form-select form-select-sm"
                                        value="@(selected.ActorRef ?? "")"
                                        @onchange="e => { selected.ActorRef = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                                    <option value="">-- 指定なし --</option>
                                    @foreach (var actor in Workspace.GetGlossaryByTypes(ConceptType.Actor))
                                    {
                                        <option value="@actor.Id">@FormatTermOption(actor) (@actor.Id)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="slot-label">
                                    トリガーイベント (TriggerEventRef)
                                    <span class="slot-type-hint">Event</span>
                                </label>
                                <select class="form-select form-select-sm"
                                        value="@(selected.TriggerEventRef ?? "")"
                                        @onchange="e => { selected.TriggerEventRef = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                                    <option value="">-- イベントを選択 --</option>
                                    @foreach (var evt in Workspace.GetGlossaryByTypes(ConceptType.Event))
                                    {
                                        <option value="@evt.Id">@FormatTermOption(evt) (@evt.Id)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }

                <!-- SUBJECT & TIMING SLOT -->
                <div class="slot-card">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="slot-label">
                                主語システム (SubjectSystemRef)
                                <span class="slot-type-hint">System</span>
                            </label>
                            <select class="form-select form-select-sm"
                                    value="@(selected.SubjectSystemRef ?? "")"
                                    @onchange="e => { selected.SubjectSystemRef = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                                <option value="">-- システムを選択 --</option>
                                @foreach (var sys in Workspace.GetGlossaryByTypes(ConceptType.System))
                                {
                                    <option value="@sys.Id">@FormatTermOption(sys) (@sys.Id)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="slot-label">タイミング (Timing)</label>
                            <div class="chip-group">
                                @foreach (var timing in Enum.GetValues<TimingKind>())
                                {
                                    var isTimingActive = selected.Behavior?.Timing == timing;
                                    <button type="button"
                                            class="slot-chip @(isTimingActive ? "active" : "")"
                                            @onclick="() => SetTiming(selected, timing)">
                                        @FormatTimingLabel(timing)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BEHAVIOR SLOT -->
                <div class="slot-card">
                    <div class="slot-card-header">
                        <span class="slot-label mb-0">動作 (Behavior)</span>
                        @if (selected.Behavior is null)
                        {
                            <button type="button" class="v2-btn v2-btn-xs v2-btn-primary" @onclick="() => InitializeBehavior(selected)">
                                <UiIcon Name="plus" Size="12" />
                                <span>Behavior を追加</span>
                            </button>
                        }
                    </div>

                    @if (selected.Behavior is null)
                    {
                        <div class="v2-alert v2-alert-danger">
                            <UiIcon Name="x-circle" Size="15" />
                            <span>Behavior が未設定です（LINT-004）。Behavior を追加するか Escape Hatch へ退避してください。</span>
                        </div>
                    }
                    else
                    {
                        var behavior = selected.Behavior;
                        var selectedDef = Workspace.FindBehaviorDefinition(behavior.BehaviorDefRef);
                        var targetCandidates = GetTargetTermsForBehavior(selectedDef);
                        var targetAllowedValues = Workspace.GetAllowedValues(behavior.TargetTermRef);
                        var targetTerm = Workspace.Document.Glossary.FirstOrDefault(
                            t => string.Equals(t.Id, behavior.TargetTermRef, StringComparison.Ordinal));
                        var hasLogicalValues = targetTerm?.LogicalType.Kind is LogicalTypeKind.Enum or LogicalTypeKind.Boolean;

                        <div class="mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="slot-label mb-0">振る舞い動詞 (BehaviorCatalog)</label>
                                @if (selectedDef is not null)
                                {
                                    <span class="v2-badge v2-badge-outline font-monospace">
                                        @selectedDef.BehaviorDefId · @selectedDef.Effect
                                    </span>
                                }
                            </div>
                            @if (Workspace.Document.BehaviorCatalog.Count == 0)
                            {
                                <div class="v2-alert v2-alert-danger">
                                    <UiIcon Name="x-circle" Size="15" />
                                    <span>BehaviorCatalog が未定義です。<a href="behaviors" class="v2-btn-link">Behaviors</a> タブから動詞を追加してください。</span>
                                </div>
                            }
                            else
                            {
                                <div class="chip-group">
                                    @foreach (var def in Workspace.Document.BehaviorCatalog)
                                    {
                                        var isActive = string.Equals(behavior.BehaviorDefRef, def.BehaviorDefId, StringComparison.Ordinal);
                                        <button type="button"
                                                class="slot-chip @(isActive ? "active" : "")"
                                                title="@def.Description (@def.Effect)"
                                                @onclick="() => OnBehaviorDefChanged(behavior, def)">
                                            <span>@def.JapaneseLabel</span>
                                            <span class="opacity-75 small">(@def.CanonicalLabel)</span>
                                        </button>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(behavior.BehaviorDefRef) && selectedDef is null)
                                {
                                    <div class="small v2-text-danger d-flex align-items-center gap-1 mt-2">
                                        <UiIcon Name="alert-triangle" Size="13" />
                                        <span>BehaviorCatalog に存在しない参照: <code>@behavior.BehaviorDefRef</code></span>
                                    </div>
                                }
                            }
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="slot-label">
                                    対象語彙 (TargetTermRef)
                                    <span class="slot-type-hint">@GetTargetTypeHint(selectedDef)</span>
                                </label>
                                <select class="form-select form-select-sm"
                                        value="@behavior.TargetTermRef"
                                        @onchange="e => OnBehaviorTargetChanged(behavior, e.Value?.ToString())">
                                    <option value="">-- 対象を選択 --</option>
                                    @foreach (var term in targetCandidates)
                                    {
                                        <option value="@term.Id">@FormatTermOption(term) (@term.ConceptType)</option>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(behavior.TargetTermRef)
                                        && !targetCandidates.Any(t => t.Id == behavior.TargetTermRef))
                                    {
                                        <option value="@behavior.TargetTermRef">
                                            [未定義] @(targetTerm is not null ? $"{FormatTermOption(targetTerm)} ({targetTerm.ConceptType})" : behavior.TargetTermRef)
                                        </option>
                                    }
                                </select>
                                @{
                                    var targetMetaHint = GetTermMetadataHint(behavior.TargetTermRef);
                                }
                                @if (!string.IsNullOrEmpty(targetMetaHint))
                                {
                                    <div class="small v2-text-secondary d-flex align-items-center gap-1 mt-1">
                                        <UiIcon Name="info" Size="13" />
                                        <span>@targetMetaHint</span>
                                    </div>
                                }
                            </div>

                            @if (selectedDef is not null && (selectedDef.RequiresFromValue || selectedDef.RequiresToValue))
                            {
                                var colSize = selectedDef.RequiresFromValue && selectedDef.RequiresToValue ? 3 : 6;
                                @if (selectedDef.RequiresFromValue)
                                {
                                    <div class="col-md-@colSize">
                                        <label class="slot-label">FromValue</label>
                                        <select class="form-select form-select-sm"
                                                value="@(behavior.FromValue ?? "")"
                                                @onchange="e => { behavior.FromValue = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                                            <option value="">-- 未選択 --</option>
                                            @foreach (var val in targetAllowedValues)
                                            {
                                                <option value="@val">@FormatValueOption(behavior.TargetTermRef, val)</option>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(behavior.FromValue)
                                                && !targetAllowedValues.Contains(behavior.FromValue, StringComparer.Ordinal))
                                            {
                                                <option value="@behavior.FromValue">[未定義] @behavior.FromValue</option>
                                            }
                                        </select>
                                    </div>
                                }
                                @if (selectedDef.RequiresToValue)
                                {
                                    <div class="col-md-@colSize">
                                        <label class="slot-label">ToValue</label>
                                        <select class="form-select form-select-sm"
                                                value="@(behavior.ToValue ?? "")"
                                                @onchange="e => { behavior.ToValue = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                                            <option value="">-- 未選択 --</option>
                                            @foreach (var val in targetAllowedValues)
                                            {
                                                <option value="@val">@FormatValueOption(behavior.TargetTermRef, val)</option>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(behavior.ToValue)
                                                && !targetAllowedValues.Contains(behavior.ToValue, StringComparer.Ordinal))
                                            {
                                                <option value="@behavior.ToValue">[未定義] @behavior.ToValue</option>
                                            }
                                        </select>
                                    </div>
                                }
                            }

                            @if (selectedDef?.Effect == SemanticEffect.Prohibit)
                            {
                                var prohibitCandidates = Workspace.Document.BehaviorCatalog
                                    .Where(b => b.Effect != SemanticEffect.Prohibit)
                                    .ToList();
                                <div class="col-md-@(hasLogicalValues ? 3 : 6)">
                                    <label class="slot-label">禁止する操作 (ProhibitedBehaviorDefRef)</label>
                                    <select class="form-select form-select-sm"
                                            value="@(behavior.ProhibitedBehaviorDefRef ?? "")"
                                            @onchange="e => OnProhibitedBehaviorChanged(behavior, e.Value?.ToString())">
                                        <option value="">-- 操作全般を禁止 --</option>
                                        @foreach (var actionDef in prohibitCandidates)
                                        {
                                            <option value="@actionDef.BehaviorDefId">@actionDef.JapaneseLabel (@actionDef.BehaviorDefId)</option>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(behavior.ProhibitedBehaviorDefRef)
                                            && !prohibitCandidates.Any(c => c.BehaviorDefId == behavior.ProhibitedBehaviorDefRef))
                                        {
                                            <option value="@behavior.ProhibitedBehaviorDefRef">[未定義] @behavior.ProhibitedBehaviorDefRef</option>
                                        }
                                    </select>
                                </div>
                                @if (hasLogicalValues)
                                {
                                    <div class="col-md-3">
                                        <label class="slot-label">禁止する値 (ProhibitedToValue)</label>
                                        <select class="form-select form-select-sm"
                                                value="@(behavior.ProhibitedToValue ?? "")"
                                                @onchange="e => { behavior.ProhibitedToValue = EmptyToNull(e.Value?.ToString()); Workspace.NotifyChanged(); }">
                                            <option value="">-- すべての値 --</option>
                                            @foreach (var val in targetAllowedValues)
                                            {
                                                <option value="@val">@FormatValueOption(behavior.TargetTermRef, val)</option>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(behavior.ProhibitedToValue)
                                                && !targetAllowedValues.Contains(behavior.ProhibitedToValue, StringComparer.Ordinal))
                                            {
                                                <option value="@behavior.ProhibitedToValue">[未定義] @behavior.ProhibitedToValue</option>
                                            }
                                        </select>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    </section>

    <!-- ==================== RIGHT PANE: PREVIEW & LINT ==================== -->
    <aside class="wb-pane wb-pane-right">
        <div class="d-flex align-items-center justify-content-between mb-2 gap-2">
            <div class="wb-section-title mb-0">Real-Time Preview</div>
            <div class="v2-segment" role="group" aria-label="Preview Mode">
                <button type="button" class="v2-segment-item @(_previewMode == "Both" ? "active" : "")"
                        @onclick='() => _previewMode = "Both"'>
                    並列
                </button>
                <button type="button" class="v2-segment-item @(_previewMode == "Japanese" ? "active" : "")"
                        @onclick='() => _previewMode = "Japanese"'>
                    日本語
                </button>
                <button type="button" class="v2-segment-item @(_previewMode == "English" ? "active" : "")"
                        @onclick='() => _previewMode = "English"'>
                    EN
                </button>
            </div>
        </div>

        @if (isAcMode)
        {
            @if (selectedAc is null)
            {
                <div class="preview-box v2-text-muted small">達成基準（AC）を選択すると WDD トレーサビリティサマリーが表示されます。</div>
            }
            else
            {
                var rightAcTrace = AcTraceabilityAnalyzer.Analyze(Workspace.Document, selectedAc.Id);
                var parentRat = Workspace.Document.Rationales.FirstOrDefault(
                    r => string.Equals(r.Id, selectedAc.RationaleId, StringComparison.Ordinal));

                <div class="preview-box">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="v2-badge v2-badge-outline">WDD 二股トレース</span>
                        <span class="v2-mono-id">@selectedAc.Id</span>
                    </div>
                    <div class="fw-bold small mt-1 v2-text-primary">@selectedAc.Title</div>
                    @if (parentRat is not null)
                    {
                        <div class="small v2-text-muted mt-1">
                            根拠: <span class="v2-mono-id">@parentRat.Id</span> @parentRat.Title
                        </div>
                    }
                    <div class="d-flex flex-column gap-1 mt-2 small">
                        <div class="d-flex justify-content-between">
                            <span class="v2-text-secondary">検証側 (E2E Journey):</span>
                            <span class="fw-semibold v2-text-primary">@selectedAc.LinkedJourneyIds.Count 件</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="v2-text-secondary">実現側 (親要求 / Atomic):</span>
                            <span class="fw-semibold v2-text-primary">@selectedAc.LinkedCompositeIds.Count 件 / @rightAcTrace.ResolvedAtomicIds.Count 件</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="v2-text-secondary">手動検証観点メモ:</span>
                            <span class="fw-semibold v2-text-primary">@(string.IsNullOrWhiteSpace(selectedAc.ManualVerificationNote) ? "なし" : "あり")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="v2-text-secondary">横飛び火候補 (他 AC):</span>
                            <span class="fw-semibold @(rightAcTrace.LateralImpactAcLinks.Count > 0 ? "v2-text-warning" : "v2-text-primary")">
                                @rightAcTrace.LateralImpactAcLinks.Count 件
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else if (selectedRationale is not null)
        {
            <div class="preview-box">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="v2-badge v2-badge-outline">Rationale (理由)</span>
                    <span class="v2-mono-id">@selectedRationale.Id</span>
                </div>
                <div class="fw-bold small mt-1 v2-text-primary">@selectedRationale.Title</div>
                <p class="small v2-prose mt-2 mb-0">
                    @(string.IsNullOrWhiteSpace(selectedRationale.Description) ? "（理由本文が未入力です）" : selectedRationale.Description)
                </p>
            </div>
        }
        else if (selected is null)
        {
            <div class="preview-box v2-text-muted small">要求を選択するとリアルタイムプレビューが表示されます。</div>
        }
        else if (selected.NodeKind == RequirementNodeKind.Atomic)
        {
            <div class="preview-box">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="v2-badge v2-badge-outline">@selected.EarsPattern</span>
                    <span class="v2-mono-id">@selected.Id</span>
                </div>
                @if (_previewMode is "Both" or "Japanese")
                {
                    <div class="small v2-text-muted mb-1">日本語 View</div>
                    <p class="preview-sentence mb-2" data-testid="japanese-preview">
                        @Workspace.RenderJapanesePreview(selected)
                    </p>
                }
                @if (_previewMode is "Both" or "English")
                {
                    <div class="small v2-text-muted mb-1">Canonical EARS (English)</div>
                    <p class="preview-en-block" data-testid="english-preview">
                        @Workspace.RenderEnglishPreview(selected)
                    </p>
                }
            </div>
        }
        else
        {
            var childAtomics = Workspace.Document.Requirements
                .Where(c => c.ParentRequirementId == selected.Id && c.NodeKind == RequirementNodeKind.Atomic)
                .ToList();
            <div class="preview-box">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="v2-badge v2-badge-outline">Composite (親要求)</span>
                    <span class="v2-mono-id">@selected.Id</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(selected.Summary))
                {
                    <p class="preview-sentence mb-3">@selected.Summary</p>
                }
                else
                {
                    <p class="small v2-text-muted mb-3">（親要求の文章が未入力です）</p>
                }

                <div class="small fw-bold v2-text-secondary mb-2">連続した振る舞いフロー (@childAtomics.Count ステップ)</div>
                @if (childAtomics.Count == 0)
                {
                    <div class="small v2-text-danger">未分解（子要求が0件のため LINT-004 エラー）</div>
                }
                else
                {
                    <ol class="ps-3 mb-0 small v2-prose">
                        @foreach (var c in childAtomics)
                        {
                            <li class="mb-2">
                                <span class="v2-mono-id fw-bold">[@c.Id]</span>
                                @if (_previewMode is "Both" or "Japanese")
                                {
                                    <div>@Workspace.RenderJapanesePreview(c)</div>
                                }
                                @if (_previewMode is "Both" or "English")
                                {
                                    <div class="font-monospace v2-text-muted small mt-1">@Workspace.RenderEnglishPreview(c)</div>
                                }
                            </li>
                        }
                    </ol>
                }
            </div>
        }

        @{
            var selectedScopeDiagnostics = isAcMode
                ? (selectedAc is null ? (IReadOnlyList<LintDiagnostic>)[] : Workspace.GetDiagnosticsForAc(selectedAc.Id))
                : (selected is null ? (IReadOnlyList<LintDiagnostic>)[] : Workspace.GetDiagnosticsForRequirement(selected.Id));
            var hasSelectedTarget = isAcMode ? selectedAc is not null : selected is not null;
        }
        <div class="d-flex align-items-center justify-content-between mt-2 mb-2 gap-2">
            <div class="wb-section-title mb-0">GraphLinter Diagnostics</div>
            <div class="v2-segment" role="group" aria-label="Diagnostics Scope">
                <button type="button" class="v2-segment-item @(!_showAllDiagnostics ? "active" : "")"
                        @onclick="() => _showAllDiagnostics = false">
                    選択中 (@selectedScopeDiagnostics.Count)
                </button>
                <button type="button" class="v2-segment-item @(_showAllDiagnostics ? "active" : "")"
                        @onclick="() => _showAllDiagnostics = true">
                    全体 (@Workspace.Diagnostics.Count)
                </button>
            </div>
        </div>

        @{
            var visibleDiagnostics = _showAllDiagnostics || !hasSelectedTarget
                ? Workspace.Diagnostics
                : selectedScopeDiagnostics;
        }

        @if (visibleDiagnostics.Count == 0)
        {
            <div class="v2-alert v2-alert-success">
                <UiIcon Name="check-circle" Size="15" />
                <span>Lint エラー・警告はありません。</span>
            </div>
        }
        else
        {
            @foreach (var diag in visibleDiagnostics)
            {
                var isErr = diag.Severity == LintSeverity.Error;
                <div class="lint-item @(isErr ? "lint-item-error" : "lint-item-warn")">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="fw-bold d-inline-flex align-items-center gap-1">
                            <UiIcon Name="@(isErr ? "x-circle" : "alert-triangle")" Size="14" />
                            <span>[@diag.RuleId] @(isErr ? "Error" : "Warning")</span>
                        </span>
                        <button type="button" class="lint-target-btn small"
                                @onclick="() => JumpToTarget(diag.TargetId)">
                            @diag.TargetId
                        </button>
                    </div>
                    <div>@diag.Message</div>
                </div>
            }
        }
    </aside>
</div>

@code {
    private bool _showAllDiagnostics;
    private string _previewMode = "Both";
    private string _acCompositeSearch = string.Empty;
    private string _newAcTag = string.Empty;

    protected override void OnInitialized()
    {
        Workspace.OnChange += HandleChanged;
    }

    private void HandleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private RenderFragment RenderAcTreeNode(AchievementCriterion ac) => __builder =>
    {
        var isSelected = string.Equals(Workspace.SelectedAcId, ac.Id, StringComparison.Ordinal);
        var diags = Workspace.GetDiagnosticsForAc(ac.Id);
        var errCount = diags.Count(d => d.Severity == LintSeverity.Error);
        var warnCount = diags.Count(d => d.Severity == LintSeverity.Warning);

        <button type="button"
                class="tree-node-btn @(isSelected ? "selected" : "")"
                @onclick="() => Workspace.SelectAc(ac.Id, switchToAcMode: true)">
            <span class="tree-node-label" title="[@ac.Id] @ac.Title">
                <span class="v2-mono-id me-1">@ac.Id</span>@ac.Title
            </span>
            <span class="tree-badges">
                @if (errCount > 0)
                {
                    <span class="chip-badge chip-err">@errCount</span>
                }
                else if (warnCount > 0)
                {
                    <span class="chip-badge chip-warn">@warnCount</span>
                }
            </span>
        </button>
    };

    private void RenameAcId(AchievementCriterion ac, string? newId)
    {
        if (string.IsNullOrWhiteSpace(newId))
        {
            return;
        }

        ac.Id = newId.Trim();
        Workspace.SelectAc(ac.Id, switchToAcMode: true);
        Workspace.NotifyChanged();
    }

    private void ToggleAcComposite(AchievementCriterion ac, string compositeId, bool isChecked)
    {
        if (isChecked)
        {
            if (!ac.LinkedCompositeIds.Contains(compositeId, StringComparer.Ordinal))
            {
                ac.LinkedCompositeIds.Add(compositeId);
            }
        }
        else
        {
            ac.LinkedCompositeIds.RemoveAll(id => string.Equals(id, compositeId, StringComparison.Ordinal));
        }
        Workspace.NotifyChanged();
    }

    private void ToggleAcJourney(AchievementCriterion ac, string journeyId, bool isChecked)
    {
        if (isChecked)
        {
            if (!ac.LinkedJourneyIds.Contains(journeyId, StringComparer.Ordinal))
            {
                ac.LinkedJourneyIds.Add(journeyId);
            }
        }
        else
        {
            ac.LinkedJourneyIds.RemoveAll(id => string.Equals(id, journeyId, StringComparison.Ordinal));
        }
        Workspace.NotifyChanged();
    }

    private void AddAcTags(AchievementCriterion ac)
    {
        if (string.IsNullOrWhiteSpace(_newAcTag))
        {
            return;
        }

        var parts = _newAcTag.Split([',', '、'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var added = false;
        foreach (var part in parts)
        {
            if (!string.IsNullOrWhiteSpace(part) && !ac.ViewpointTags.Contains(part, StringComparer.Ordinal))
            {
                ac.ViewpointTags.Add(part);
                added = true;
            }
        }

        _newAcTag = string.Empty;
        if (added)
        {
            Workspace.NotifyChanged();
        }
    }

    private void OnAcTagKeyDown(KeyboardEventArgs e, AchievementCriterion ac)
    {
        if (e.Key == "Enter")
        {
            AddAcTags(ac);
        }
    }

    private void RemoveAcTag(AchievementCriterion ac, string tag)
    {
        ac.ViewpointTags.Remove(tag);
        Workspace.NotifyChanged();
    }

    private RenderFragment RenderTreeNode(CanonicalRequirementNode node, bool isChild) => __builder =>
    {
        var isSelected = string.Equals(Workspace.SelectedRequirementId, node.Id, StringComparison.Ordinal);
        var diags = Workspace.GetDiagnosticsForRequirement(node.Id);
        var errs = diags.Count(d => d.Severity == LintSeverity.Error);
        var warns = diags.Count(d => d.Severity == LintSeverity.Warning);

        <button type="button"
                class="tree-node-btn @(isChild ? "tree-node-atomic" : "tree-node-composite") @(isSelected ? "selected" : "")"
                @onclick="() => Workspace.SelectRequirement(node.Id)">
            <span class="tree-node-label" title="@($"[{node.Id}] {node.Title}")">
                <span class="v2-mono-id me-1">@node.Id</span>@node.Title
            </span>
            <span class="tree-badges">
                @if (errs > 0)
                {
                    <span class="v2-badge v2-badge-danger">@errs</span>
                }
                @if (warns > 0)
                {
                    <span class="v2-badge v2-badge-warning">@warns</span>
                }
            </span>
        </button>
    };

    private void ToggleRationaleRef(CanonicalRequirementNode node, string ratId)
    {
        if (node.RationaleRefs.Contains(ratId, StringComparer.Ordinal))
        {
            node.RationaleRefs.RemoveAll(r => string.Equals(r, ratId, StringComparison.Ordinal));
        }
        else
        {
            node.RationaleRefs.Add(ratId);
        }

        Workspace.NotifyChanged();
    }

    private void SelectEarsPattern(CanonicalRequirementNode node, EarsEntryPattern pattern)
    {
        node.EarsPattern = pattern;

        if (!ShowsTrigger(pattern))
        {
            node.TriggerEventRef = null;
            node.ActorRef = null;
        }

        if (!ShowsPreconditions(pattern))
        {
            node.Preconditions.Clear();
        }

        Workspace.NotifyChanged();
    }

    private static bool ShowsPreconditions(EarsEntryPattern pattern) =>
        pattern is EarsEntryPattern.EventDriven
            or EarsEntryPattern.StateDriven
            or EarsEntryPattern.UnwantedBehavior
            or EarsEntryPattern.OptionalFeature;

    private static bool ShowsTrigger(EarsEntryPattern pattern) =>
        pattern is EarsEntryPattern.EventDriven
            or EarsEntryPattern.UnwantedBehavior
            or EarsEntryPattern.OptionalFeature;

    private void AddPrecondition(CanonicalRequirementNode node)
    {
        var firstState = Workspace.GetGlossaryByTypes(ConceptType.StateVariable, ConceptType.LifecycleState).FirstOrDefault();
        var allowed = firstState is not null ? Workspace.GetAllowedValues(firstState.Id) : [];

        node.Preconditions.Add(new PreconditionClause
        {
            StateTermRef = firstState?.Id ?? string.Empty,
            Operator = ComparisonOperator.EQ,
            ExpectedValues = allowed.Count > 0 ? [allowed[0]] : []
        });
        Workspace.NotifyChanged();
    }

    private void OnPreconditionStateChanged(PreconditionClause clause, string? newStateRef)
    {
        clause.StateTermRef = newStateRef ?? string.Empty;
        var allowed = Workspace.GetAllowedValues(clause.StateTermRef);
        clause.ExpectedValues = allowed.Count > 0 ? [allowed[0]] : [];
        Workspace.NotifyChanged();
    }

    private void OnPreconditionOperatorChanged(PreconditionClause clause, string? opStr)
    {
        if (Enum.TryParse<ComparisonOperator>(opStr, out var op))
        {
            clause.Operator = op;
            if (op != ComparisonOperator.IN && clause.ExpectedValues.Count > 1)
            {
                clause.ExpectedValues = [clause.ExpectedValues[0]];
            }
            Workspace.NotifyChanged();
        }
    }

    private void ToggleExpectedValue(PreconditionClause clause, string val)
    {
        if (clause.Operator == ComparisonOperator.IN)
        {
            if (clause.ExpectedValues.Contains(val, StringComparer.Ordinal))
            {
                clause.ExpectedValues.RemoveAll(v => string.Equals(v, val, StringComparison.Ordinal));
            }
            else
            {
                clause.ExpectedValues.Add(val);
            }
        }
        else
        {
            clause.ExpectedValues = [val];
        }

        Workspace.NotifyChanged();
    }

    private void SetTiming(CanonicalRequirementNode node, TimingKind timing)
    {
        node.Behavior ??= Workspace.CreateDefaultBehaviorNode();
        node.Behavior.Timing = timing;
        Workspace.NotifyChanged();
    }

    private void InitializeBehavior(CanonicalRequirementNode node)
    {
        node.Behavior = Workspace.CreateDefaultBehaviorNode();
        Workspace.NotifyChanged();
    }

    private void OnBehaviorDefChanged(BehaviorNode behavior, BehaviorDefinition def)
    {
        behavior.BehaviorDefRef = def.BehaviorDefId;
        behavior.FromValue = null;
        behavior.ToValue = null;

        if (def.Effect != SemanticEffect.Prohibit)
        {
            behavior.ProhibitedBehaviorDefRef = null;
            behavior.ProhibitedToValue = null;
        }
        else if (!string.IsNullOrWhiteSpace(behavior.ProhibitedBehaviorDefRef))
        {
            var prohibitedDef = Workspace.FindBehaviorDefinition(behavior.ProhibitedBehaviorDefRef);
            if (prohibitedDef is null || prohibitedDef.Effect == SemanticEffect.Prohibit)
            {
                behavior.ProhibitedBehaviorDefRef = null;
            }
        }

        var candidates = GetTargetTermsForBehavior(def);
        if (!candidates.Any(c => string.Equals(c.Id, behavior.TargetTermRef, StringComparison.Ordinal)))
        {
            behavior.TargetTermRef = candidates.FirstOrDefault()?.Id ?? string.Empty;
            behavior.ProhibitedToValue = null;
        }

        AutoPopulateSlotValues(behavior, def);
        Workspace.NotifyChanged();
    }

    private void OnBehaviorTargetChanged(BehaviorNode behavior, string? targetRef)
    {
        behavior.TargetTermRef = targetRef ?? string.Empty;
        behavior.FromValue = null;
        behavior.ToValue = null;
        behavior.ProhibitedToValue = null;

        var def = Workspace.FindBehaviorDefinition(behavior.BehaviorDefRef);
        AutoPopulateSlotValues(behavior, def);
        Workspace.NotifyChanged();
    }

    private void AutoPopulateSlotValues(BehaviorNode behavior, BehaviorDefinition? def)
    {
        if (def is null || string.IsNullOrWhiteSpace(behavior.TargetTermRef))
        {
            return;
        }

        var allowed = Workspace.GetAllowedValues(behavior.TargetTermRef);
        if (def.RequiresFromValue && def.RequiresToValue && allowed.Count >= 2)
        {
            behavior.FromValue = allowed[0];
            behavior.ToValue = allowed[1];
        }
        else if (def.RequiresToValue && allowed.Count >= 1)
        {
            behavior.ToValue = allowed[0];
        }
        else if (def.RequiresFromValue && allowed.Count >= 1)
        {
            behavior.FromValue = allowed[0];
        }
    }

    private void OnProhibitedBehaviorChanged(BehaviorNode behavior, string? defId)
    {
        behavior.ProhibitedBehaviorDefRef = EmptyToNull(defId);
        Workspace.NotifyChanged();
    }

    private IReadOnlyList<ApprovedGlossaryTerm> GetTargetTermsForBehavior(BehaviorDefinition? def) =>
        def is not null && def.AllowedTargetTypes.Count > 0
            ? Workspace.GetGlossaryByTypes(def.AllowedTargetTypes.ToArray())
            : Workspace.GetGlossaryByTypes(
                ConceptType.DomainObject,
                ConceptType.Attribute,
                ConceptType.LifecycleState,
                ConceptType.StateVariable);

    private static string GetTargetTypeHint(BehaviorDefinition? def) =>
        def is not null && def.AllowedTargetTypes.Count > 0
            ? string.Join(" / ", def.AllowedTargetTypes)
            : "DomainObject / Attribute / State";

    private void ActivateEscapeHatch(CanonicalRequirementNode node)
    {
        Workspace.EnableEscapeHatch(node, EscapeReason.ComplexTemporalConstraint, string.Empty);
    }

    private void OnEscapeReasonChanged(FreeTextEscapeRecord record, string? reasonStr)
    {
        if (Enum.TryParse<EscapeReason>(reasonStr, out var reason))
        {
            record.Reason = reason;
            Workspace.NotifyChanged();
        }
    }

    private void JumpToTarget(string targetId)
    {
        if (Workspace.Document.AchievementCriteria.Any(ac => string.Equals(ac.Id, targetId, StringComparison.Ordinal)))
        {
            Workspace.SelectAc(targetId, switchToAcMode: true);
            return;
        }

        if (Workspace.Document.Requirements.Any(r => r.Id == targetId))
        {
            Workspace.SelectRequirement(targetId);
            return;
        }

        var escape = Workspace.Document.EscapeRecords.FirstOrDefault(e => e.Id == targetId);
        if (escape is not null && Workspace.Document.Requirements.Any(r => r.Id == escape.RequirementId))
        {
            Workspace.SelectRequirement(escape.RequirementId);
        }
    }

    private static string FormatEarsLabel(EarsEntryPattern p) => p switch
    {
        EarsEntryPattern.Ubiquitous => "Ubiquitous (普遍)",
        EarsEntryPattern.EventDriven => "EventDriven (イベント)",
        EarsEntryPattern.StateDriven => "StateDriven (状態)",
        EarsEntryPattern.UnwantedBehavior => "Unwanted (異常・禁止)",
        EarsEntryPattern.OptionalFeature => "Optional (オプション)",
        _ => p.ToString()
    };

    private static string FormatTimingLabel(TimingKind t) => t switch
    {
        TimingKind.UNSPECIFIED => "指定なし",
        TimingKind.IMMEDIATE => "即座に (IMMEDIATE)",
        TimingKind.EVENTUAL => "最終的に (EVENTUAL)",
        _ => t.ToString()
    };

    private static string FormatEscapeReason(EscapeReason r) => r switch
    {
        EscapeReason.UnsupportedEarsPattern => "UnsupportedEarsPattern (EARS表現不可)",
        EscapeReason.UnsupportedBehaviorKind => "UnsupportedBehaviorKind (Behavior表現不可)",
        EscapeReason.ComplexTemporalConstraint => "ComplexTemporalConstraint (複雑な時間・SLA制約)",
        EscapeReason.MissingDomainVocabulary => "MissingDomainVocabulary (語彙不足)",
        EscapeReason.QuantitativeCalculation => "QuantitativeCalculation (数値計算・数式)",
        EscapeReason.ExternalSystemConstraint => "ExternalSystemConstraint (外部システム・法規制制約)",
        _ => r.ToString()
    };

    private static string FormatTermOption(ApprovedGlossaryTerm term)
    {
        var display = term.GetDisplayName();
        return string.Equals(display, term.CanonicalName, StringComparison.Ordinal)
            ? term.CanonicalName
            : $"{display} [{term.CanonicalName}]";
    }

    private string FormatValueOption(string? termRef, string val)
    {
        if (string.IsNullOrWhiteSpace(termRef))
        {
            return val;
        }

        var term = Workspace.Document.Glossary.FirstOrDefault(t => string.Equals(t.Id, termRef, StringComparison.Ordinal));
        if (term is null)
        {
            return val;
        }

        var label = term.LogicalType.GetValueLabel(val);
        return string.Equals(label, val, StringComparison.Ordinal) ? val : $"{label} ({val})";
    }

    private string? GetTermMetadataHint(string? termRef)
    {
        if (string.IsNullOrWhiteSpace(termRef))
        {
            return null;
        }

        var term = Workspace.Document.Glossary.FirstOrDefault(t => string.Equals(t.Id, termRef, StringComparison.Ordinal));
        if (term is null)
        {
            return null;
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(term.Unit))
        {
            parts.Add($"単位: {term.Unit}");
        }
        if (!string.IsNullOrWhiteSpace(term.AbstractionNote))
        {
            parts.Add(term.AbstractionNote);
        }

        return parts.Count == 0 ? null : string.Join(" / ", parts);
    }

    private static string? EmptyToNull(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    public void Dispose()
    {
        Workspace.OnChange -= HandleChanged;
    }
}
