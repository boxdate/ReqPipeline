@inherits LayoutComponentBase
@implements IDisposable
@inject WorkspaceStateService Workspace
@inject IJSRuntime JS

<div class="v2-shell">
    <header class="v2-header">
        <div class="v2-header-left">
            <div class="v2-brand">
                <span class="v2-brand-mark" aria-hidden="true"></span>
                <span class="v2-brand-title">ReqPipeline</span>
                <span class="v2-schema-tag">V2</span>
            </div>

            <nav class="v2-nav" aria-label="Primary Navigation">
                <NavLink class="v2-nav-tab" href="" Match="NavLinkMatch.All">
                    Workbench
                </NavLink>
                <NavLink class="v2-nav-tab" href="glossary">
                    Glossary
                </NavLink>
                <NavLink class="v2-nav-tab" href="behaviors">
                    Behaviors
                </NavLink>
                <NavLink class="v2-nav-tab" href="usdm">
                    USDM
                </NavLink>
                <NavLink class="v2-nav-tab" href="fsm">
                    FSM
                </NavLink>
                <NavLink class="v2-nav-tab" href="journey">
                    Journey
                </NavLink>
                <NavLink class="v2-nav-tab" href="tests">
                    Tests
                </NavLink>
            </nav>
        </div>

        <div class="v2-header-right">
            <div class="v2-lint-summary" title="GraphLinter リアルタイム検証結果">
                <span class="v2-status-pill @(Workspace.ErrorCount == 0 ? "v2-status-pill-ok" : "v2-status-pill-error")">
                    <span class="v2-dot @(Workspace.ErrorCount == 0 ? "v2-dot-success" : "v2-dot-danger")"></span>
                    <span>Errors: @Workspace.ErrorCount</span>
                </span>
                @if (Workspace.WarningCount > 0)
                {
                    <span class="v2-status-pill v2-status-pill-warn">
                        <span class="v2-dot v2-dot-warning"></span>
                        <span>Warnings: @Workspace.WarningCount</span>
                    </span>
                }
            </div>

            <div class="v2-header-actions">
                <div class="v2-segment" role="group" aria-label="Sample Switcher" title="サンプルデータセットを切替">
                    <button type="button"
                            class="v2-segment-item @(Workspace.ActiveSampleKey == "crud" ? "active" : "")"
                            @onclick='() => SwitchSample("crud", "CRUD")'>
                        CRUD
                    </button>
                    <button type="button"
                            class="v2-segment-item @(Workspace.ActiveSampleKey == "doorlock" ? "active" : "")"
                            @onclick='() => SwitchSample("doorlock", "DoorLock")'>
                        DoorLock
                    </button>
                </div>

                <label class="v2-btn v2-btn-sm v2-btn-outline mb-0" role="button" title="V2 JSONファイルをインポート">
                    <UiIcon Name="upload" Size="14" />
                    <span>Import</span>
                    <InputFile OnChange="HandleImportJson" accept=".json,application/json" style="display:none" />
                </label>

                <button type="button" class="v2-btn v2-btn-sm v2-btn-outline" @onclick="HandleExportJson" title="現在の正本JSONをダウンロード">
                    <UiIcon Name="download" Size="14" />
                    <span>Export</span>
                </button>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="v2-banner @(_statusIsError ? "v2-banner-error" : "v2-banner-info")">
            <span class="d-inline-flex align-items-center gap-2">
                <UiIcon Name="@(_statusIsError ? "x-circle" : "check-circle")" Size="15" />
                <span>@_statusMessage</span>
            </span>
            <button type="button" class="v2-banner-close" aria-label="閉じる" @onclick="() => _statusMessage = null">
                <UiIcon Name="x" Size="15" />
            </button>
        </div>
    }

    <main class="v2-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    予期しないエラーが発生しました。
    <a href="." class="reload">再読み込み</a>
    <span class="dismiss">×</span>
</div>

@code {
    private string? _statusMessage;
    private bool _statusIsError;

    protected override void OnInitialized()
    {
        Workspace.OnChange += HandleWorkspaceChanged;
    }

    private void HandleWorkspaceChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SwitchSample(string sampleKey, string displayName)
    {
        if (Workspace.TryLoadSample(sampleKey, out var error))
        {
            _statusIsError = false;
            _statusMessage = $"'{displayName}' サンプルを読み込みました（要求: {Workspace.Document.Requirements.Count}件 / 動詞: {Workspace.Document.BehaviorCatalog.Count}件 / 語彙: {Workspace.Document.Glossary.Count}件）。";
        }
        else
        {
            _statusIsError = true;
            _statusMessage = error ?? $"'{displayName}' サンプルの読み込みに失敗しました。";
        }
    }

    private async Task HandleImportJson(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            if (Workspace.TryImportJson(json, out var error))
            {
                _statusIsError = false;
                _statusMessage = $"'{file.Name}' をインポートしました（要求: {Workspace.Document.Requirements.Count}件 / 語彙: {Workspace.Document.Glossary.Count}件）。";
            }
            else
            {
                _statusIsError = true;
                _statusMessage = error ?? "JSONのインポートに失敗しました。";
            }
        }
        catch (Exception ex)
        {
            _statusIsError = true;
            _statusMessage = $"ファイル読み込みエラー: {ex.Message}";
        }
    }

    private async Task HandleExportJson()
    {
        var json = Workspace.ExportJson();
        var docId = string.IsNullOrWhiteSpace(Workspace.Document.DocumentId)
            ? "knowledge-graph"
            : Workspace.Document.DocumentId.ToLowerInvariant();
        var fileName = $"{docId}.v2.json";

        await JS.InvokeVoidAsync("reqPipelineV2.downloadTextFile", fileName, json, "application/json;charset=utf-8");
        _statusIsError = false;
        _statusMessage = $"'{fileName}' をエクスポートしました。";
    }

    public void Dispose()
    {
        Workspace.OnChange -= HandleWorkspaceChanged;
    }
}
